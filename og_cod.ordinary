	}, {
		duration: 1200 + Math.random() * 2000,
		// 1.2-3.2 seconds for more responsive changes
		easing: tween.easeInOut
	});
}, 1500 + Math.random() * 2500); // Every 1.5-4 seconds for more frequent changes
