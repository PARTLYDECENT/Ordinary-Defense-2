				scaleX: selectedCloud.scaleX * 0.6,
				// Shrink to 60% size
				scaleY: selectedCloud.scaleY * 0.6,
				tint: shouldFlyToBase ? 0x660000 : 0x220000,
				// Dark red for base impact, very dark red/black for enemy
				alpha: 0.9
			}, {
				duration: 1500,
				easing: tween.easeInOut,
