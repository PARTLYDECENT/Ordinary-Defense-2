// Color palette for shader transitions
var shaderColors = [0xFF6600,
// Warm orange
0x6600FF,
// Deep purple
0x00FF66,
// Bright green
0xFF0066,
// Hot pink
0x0066FF,
// Electric blue
0xFFFF00,
// Bright yellow
0xFF3300,
// Fiery red
0x00FFFF,
// Cyan
0xFF9900,
// Amber
0x9900FF // Violet
];
var currentShaderColorIndex = 0;
var shaderTransitionActive = false;
// Function to transition to next shader color
function transitionShaderColor() {
	if (shaderTransitionActive) {
		return;
	}
	shaderTransitionActive = true;
	// Get next color in sequence
	var nextColorIndex = (currentShaderColorIndex + 1) % shaderColors.length;
	var nextColor = shaderColors[nextColorIndex];
	// Create smooth color transition with more dramatic alpha changes for stronger effect
	tween(shaderOverlay, {
		tint: nextColor,
		alpha: 0.35 + Math.random() * 0.40 // Random alpha between 0.35-0.75 for dramatic variety
	}, {
		duration: 1500 + Math.random() * 2500,
		// 1.5-4 seconds for more dynamic transitions
		easing: tween.easeInOut,
		onFinish: function onFinish() {
			currentShaderColorIndex = nextColorIndex;
			shaderTransitionActive = false;
		}
	});
	// Add secondary overlay for more complex color mixing - enhanced coverage and intensity
	if (Math.random() < 0.5) {
		// 50% chance for dual-color effect
		var secondaryOverlay = LK.getAsset('healthBarBg', {
			anchorX: 0.0,
			anchorY: 0.0,
			x: -200,
			y: -200,
			width: 2448,
			height: 3132,
			alpha: 0,
			tint: shaderColors[Math.floor(Math.random() * shaderColors.length)]
		});
		backgroundContainer.addChild(secondaryOverlay);
		// Fade in secondary overlay with stronger effect
		tween(secondaryOverlay, {
			alpha: 0.25
		}, {
			duration: 1200,
			easing: tween.easeIn,
			onFinish: function onFinish() {
				// Fade out after brief mixing
				tween(secondaryOverlay, {
					alpha: 0
				}, {
					duration: 1800,
					easing: tween.easeOut,
					onFinish: function onFinish() {
						backgroundContainer.removeChild(secondaryOverlay);
					}
				});
			}
		});
	}
	// Add tertiary overlay for complete skybox transformation
	if (Math.random() < 0.3) {
		// 30% chance for triple-layer effect
		var tertiaryOverlay = LK.getAsset('healthBarBg', {
			anchorX: 0.0,
			anchorY: 0.0,
			x: -300,
			y: -300,
			width: 2648,
			height: 3332,
			alpha: 0,
			tint: shaderColors[Math.floor(Math.random() * shaderColors.length)]
		});
		backgroundContainer.addChild(tertiaryOverlay);
		// Create sweeping effect across entire skybox
		tween(tertiaryOverlay, {
			alpha: 0.20,
			x: -100,
			y: -100
		}, {
			duration: 2000,
			easing: tween.easeInOut,
			onFinish: function onFinish() {
				tween(tertiaryOverlay, {
					alpha: 0,
					x: 100,
					y: 100
				}, {
					duration: 2500,
					easing: tween.easeOut,
					onFinish: function onFinish() {
						backgroundContainer.removeChild(tertiaryOverlay);
					}
				});
			}
		});
	}
}
// Start continuous shader color transitions
