						var cloudEnemy = new CloudEnemy(40); // Good reward for tough enemy
						cloudEnemy.x = selectedCloud.x;
						cloudEnemy.y = selectedCloud.y;
						// Make it fly down to the nearest path point
						var nearestPathIndex = 0;
						var shortestDistance = Infinity;
						for (var i = 0; i < gamePath.length; i++) {
							var dx = gamePath[i].x - cloudEnemy.x;
							var dy = gamePath[i].y - cloudEnemy.y;
							var distance = Math.sqrt(dx * dx + dy * dy);
							if (distance < shortestDistance) {
								shortestDistance = distance;
								nearestPathIndex = i;
							}
						}
						// Set the cloud enemy to start from the nearest path point
						cloudEnemy.pathIndex = nearestPathIndex;
						// Add dramatic descent effect
						var descentStartY = cloudEnemy.y;
						var targetY = gamePath[nearestPathIndex].y;
						tween(cloudEnemy, {
							x: gamePath[nearestPathIndex].x,
							y: targetY
						}, {
							duration: 2000,
							easing: tween.easeOut,
							onFinish: function onFinish() {
								// Now it behaves like a normal enemy on the path
								game.addChild(cloudEnemy);
