	self.removeChild(self.children[0]); // Remove default tower graphic
	var towerGraphic = self.attachAsset('DRONEFACTORY', {
		anchorX: 0.5,
		anchorY: 1.0,
		tint: 0x55FF55,
		// Green tint for drone factory
		scaleX: 2.4,
		scaleY: 2.4
	});
	// Drones array to track active drones
