	var _pulseElectric = function pulseElectric() {
		if (electricAura && electricAura.parent) {
			tween(electricAura, {
				alpha: 0.6,
				scaleX: 1.2,
				scaleY: 1.2
			}, {
				duration: 800,
				onFinish: function onFinish() {
					if (electricAura && electricAura.parent) {
						tween(electricAura, {
							alpha: 0.3,
							scaleX: 1.0,
							scaleY: 1.0
