			goldText.setText("Gold: " + gold);
			return turret;
		}
		return null;
	};
	return self;
});

/**** 
* Initialize Game
****/
// Define a parentUpdate function to avoid 'TypeError: parentUpdate is undefined'
var game = new LK.Game({
	backgroundColor: 0x000000 // Black background for sci-fi theme
});

/**** 
* Game Code
****/
// Create a realistic layered skybox system with depth
var backgroundContainer = new Container();
game.addChild(backgroundContainer);
// Create multiple depth layers for raycasted effect
var skyboxLayers = [];
var numLayers = 4; // Multiple layers for depth
// Layer 1: Far background - largest scale, slowest movement
var farLayer = new Container();
backgroundContainer.addChild(farLayer);
skyboxLayers.push({
	container: farLayer,
	parallaxSpeed: 0.1,
	scale: 3.5,
	alpha: 0.3
});
// Layer 2: Mid-far background
var midFarLayer = new Container();
backgroundContainer.addChild(midFarLayer);
skyboxLayers.push({
	container: midFarLayer,
	parallaxSpeed: 0.3,
	scale: 2.8,
	alpha: 0.5
});
// Layer 3: Mid background  
var midLayer = new Container();
backgroundContainer.addChild(midLayer);
skyboxLayers.push({
	container: midLayer,
	parallaxSpeed: 0.6,
	scale: 2.2,
	alpha: 0.7
});
// Layer 4: Near background - smallest scale, fastest movement
var nearLayer = new Container();
backgroundContainer.addChild(nearLayer);
skyboxLayers.push({
	container: nearLayer,
	parallaxSpeed: 1.0,
	scale: 1.8,
	alpha: 0.9
});
// Get skybox asset information for sizing
var skyboxAsset = LK.getAsset('skybox', {
	anchorX: 0.0,
	anchorY: 0.0,
	scaleX: 1.0,
	scaleY: 1.0,
	x: 0,
	y: 0
});
var tileWidth = skyboxAsset.width;
var tileHeight = skyboxAsset.height;
var skyboxAssets = ['skybox', 'skybox1', 'skybox2'];
var skyboxTiles = [];
// Array to track NPCs in skybox
var skyboxNPCs = [];
// --- NPC Mining System ---
var selectedNPC = null; // Track selected NPC1
var npcMiningTarget = null; // Target position for mining
var npcMiningActive = false;
var npcMiningProgress = 0;
var npcMiningStonePerCycle = 5;
var npcMiningDuration = 60; // frames to mine (1 second at 60fps)
var npcMiningStoneText = null; // Floating text for mining
// Helper: Find the closest NPC1 to a point (x, y)
function getNPC1At(x, y) {
	var closest = null;
	var minDist = 99999;
	for (var i = 0; i < skyboxNPCs.length; i++) {
		var npc = skyboxNPCs[i];
		// Only allow selection of NPC1 (by asset id)
		if (npc.assetId && npc.assetId !== 'npc1') {
			continue;
		}
		var dx = npc.x - x;
		var dy = npc.y - y;
		var dist = Math.sqrt(dx * dx + dy * dy);
		if (dist < 80 && dist < minDist) {
			// 80px selection radius
			closest = npc;
			minDist = dist;
		}
	}
	return closest;
}
// Helper: Deselect NPC
function deselectNPC() {
	if (selectedNPC && selectedNPC.selectionRing) {
		selectedNPC.removeChild(selectedNPC.selectionRing);
		selectedNPC.selectionRing = null;
	}
	selectedNPC = null;
	npcMiningTarget = null;
	npcMiningActive = false;
	npcMiningProgress = 0;
}
// Helper: Show selection ring on NPC
function showNPCSelectionRing(npc) {
	if (npc.selectionRing) {
		return;
	}
	var ring = LK.getAsset('rangeIndicator', {
		anchorX: 0.5,
		anchorY: 0.5,
		x: 0,
		y: 0,
		alpha: 0.5,
		tint: 0x00FFFF,
		width: 120,
		height: 120
	});
	npc.addChild(ring);
	npc.selectionRing = ring;
	// Pulse effect
	tween(ring, {
		alpha: 0.2,
		width: 100,
		height: 100
	}, {
		duration: 700,
		yoyo: true,
		repeat: Infinity
	});
}
// Helper: Show mining floating text
function showMiningText(x, y, amount) {
	if (npcMiningStoneText) {
		npcMiningStoneText.destroy();
	}
	var txt = new Text2("+" + amount + " Stone", {
		size: 40,
		fill: 0x708090
	});
	txt.anchor.set(0.5, 0.5);
	txt.x = x;
	txt.y = y - 60;
	txt.alpha = 1;
	game.addChild(txt);
	tween(txt, {
		y: txt.y - 40,
		alpha: 0
	}, {
		duration: 900,
		onFinish: function onFinish() {
			txt.destroy();
		}
	});
	npcMiningStoneText = txt;
}
// Create layered skybox with different properties per layer
for (var layerIndex = 0; layerIndex < skyboxLayers.length; layerIndex++) {
	var layer = skyboxLayers[layerIndex];
	var layerScale = layer.scale;
	// Calculate tiles needed for this layer
	var tilesX = Math.ceil(2048 / (tileWidth * layerScale)) + 2;
	var tilesY = Math.ceil(2732 / (tileHeight * layerScale)) + 2;
	// Create tiles for this layer
	for (var i = 0; i < tilesX; i++) {
		for (var j = 0; j < tilesY; j++) {
			// Create varied pattern per layer
			var assetIndex = (i + j + layerIndex) % 3;
			var selectedSkyboxAsset = skyboxAssets[assetIndex];
			var tile = LK.getAsset(selectedSkyboxAsset, {
				anchorX: 0.0,
				anchorY: 0.0,
				x: i * tileWidth * layerScale - tileWidth,
				y: j * tileHeight * layerScale - tileHeight,
				scaleX: layerScale,
				scaleY: layerScale,
				alpha: layer.alpha
			});
			// Add atmospheric tinting based on layer depth
			var layerTint = 0x888888 + layerIndex * 0x222222;
			tile.tint = layerTint;
			// Store tile info for transitions and parallax
			tile.originalAssetIndex = assetIndex;
			tile.gridX = i;
			tile.gridY = j;
			tile.layerIndex = layerIndex;
			tile.baseX = tile.x;
			tile.baseY = tile.y;
			layer.container.addChild(tile);
			skyboxTiles.push(tile);
		}
	}
	// Create neutral NPCs for world building in each layer
	var npcCount = 3 + layerIndex; // More NPCs in closer layers
	for (var n = 0; n < npcCount; n++) {
		var npc = LK.getAsset('npc1', {
			anchorX: 0.5,
			anchorY: 0.5,
			x: Math.random() * 2048,
			y: Math.random() * 2732,
			scaleX: layerScale * 0.8,
			scaleY: layerScale * 0.8,
			alpha: layer.alpha * 0.7,
			tint: layerTint
		});
		// NPC movement properties
		npc.moveSpeed = 0.5 + Math.random() * 1.0;
		npc.direction = Math.random() * Math.PI * 2;
		npc.directionChangeTimer = 0;
		npc.directionChangeInterval = 3000 + Math.random() * 4000;
		npc.layerIndex = layerIndex;
		npc.baseX = npc.x;
		npc.baseY = npc.y;
		layer.container.addChild(npc);
		skyboxNPCs.push(npc);
	}
}
// Function to create atmospheric depth transitions
function createSkyboxTransition() {
	// Pick a random tile to transition from a random layer
	var randomTileIndex = Math.floor(Math.random() * skyboxTiles.length);
	var tile = skyboxTiles[randomTileIndex];
	var layerInfo = skyboxLayers[tile.layerIndex];
	// Choose next skybox asset in sequence
	var nextAssetIndex = (tile.originalAssetIndex + 1) % 3;
	var nextSkyboxAsset = skyboxAssets[nextAssetIndex];
	// Create atmospheric tinting based on layer depth
	var layerTint = 0x888888 + tile.layerIndex * 0x222222;
	// Create the new tile for transition
	var newTile = LK.getAsset(nextSkyboxAsset, {
		anchorX: 0.0,
		anchorY: 0.0,
		x: tile.x,
		y: tile.y,
		scaleX: tile.scaleX,
		scaleY: tile.scaleY,
		alpha: 0,
		tint: layerTint
	});
	newTile.originalAssetIndex = nextAssetIndex;
	newTile.gridX = tile.gridX;
	newTile.gridY = tile.gridY;
	newTile.layerIndex = tile.layerIndex;
	newTile.baseX = tile.baseX;
	newTile.baseY = tile.baseY;
	layerInfo.container.addChild(newTile);
	// Enhanced atmospheric transition with depth-based timing
	var transitionDuration = 1500 + tile.layerIndex * 500 + Math.random() * 2000;
	// Keep the second skybox layer (layerIndex 1) always visible by maintaining its alpha
	if (tile.layerIndex === 1) {
		// For second layer, just replace the tile without alpha transitions
		layerInfo.container.removeChild(tile);
		layerInfo.container.addChild(newTile);
		newTile.alpha = layerInfo.alpha; // Maintain the layer's alpha
		skyboxTiles[randomTileIndex] = newTile;
	} else {
		// For other layers, fade out old tile and fade in new tile
		tween(tile, {
			alpha: 0
		}, {
			duration: transitionDuration,
			onFinish: function onFinish() {
				layerInfo.container.removeChild(tile);
			}
		});
		tween(newTile, {
			alpha: layerInfo.alpha
		}, {
			duration: transitionDuration,
			onFinish: function onFinish() {
				// Replace the old tile in our array
				skyboxTiles[randomTileIndex] = newTile;
			}
		});
	}
	// Create atmospheric wave effect on neighboring tiles within same layer
	createAtmosphericWaveTransition(tile.gridX, tile.gridY, tile.layerIndex, nextAssetIndex);
}
// Function to create atmospheric wave transitions across neighboring tiles in same layer
function createAtmosphericWaveTransition(centerX, centerY, layerIndex, targetAssetIndex) {
	var waveRadius = 2; // How far the wave extends
	var baseDelay = 200 + layerIndex * 100; // Layer-dependent delay for realism
	var layerInfo = skyboxLayers[layerIndex];
	for (var radius = 1; radius <= waveRadius; radius++) {
		LK.setTimeout(function (r) {
			return function () {
				// Find tiles at this radius from center within same layer
				for (var i = 0; i < skyboxTiles.length; i++) {
					var tile = skyboxTiles[i];
					if (tile.layerIndex !== layerIndex) {
						continue;
					} // Only affect same layer
					var dx = Math.abs(tile.gridX - centerX);
					var dy = Math.abs(tile.gridY - centerY);
					var distance = Math.max(dx, dy); // Use chess distance for square wave
					if (distance === r && Math.random() < 0.3) {
						// 30% chance for each neighboring tile for subtle effect
						var nextAssetIndex = (tile.originalAssetIndex + 1) % 3;
						var nextSkyboxAsset = skyboxAssets[nextAssetIndex];
						// Create atmospheric tinting
						var layerTint = 0x888888 + layerIndex * 0x222222;
						// Create new tile for this neighbor
						var neighborTile = LK.getAsset(nextSkyboxAsset, {
							anchorX: 0.0,
							anchorY: 0.0,
							x: tile.x,
							y: tile.y,
							scaleX: tile.scaleX,
							scaleY: tile.scaleY,
							alpha: 0,
							tint: layerTint
						});
						neighborTile.originalAssetIndex = nextAssetIndex;
						neighborTile.gridX = tile.gridX;
						neighborTile.gridY = tile.gridY;
						neighborTile.layerIndex = layerIndex;
						neighborTile.baseX = tile.baseX;
						neighborTile.baseY = tile.baseY;
						layerInfo.container.addChild(neighborTile);
						// Layer-dependent transition timing for atmospheric effect
						var transitionDuration = 1200 + layerIndex * 300;
						// Protect second skybox layer from wave transitions
						if (layerIndex === 1) {
							// For second layer, just replace without transitions to maintain visibility
							layerInfo.container.removeChild(tile);
							layerInfo.container.addChild(neighborTile);
							neighborTile.alpha = layerInfo.alpha; // Keep the layer's alpha
							var tileIndex = skyboxTiles.indexOf(tile);
							if (tileIndex !== -1) {
								skyboxTiles[tileIndex] = neighborTile;
							}
						} else {
							// Cross-fade transition for other layers
							tween(tile, {
								alpha: 0
							}, {
								duration: transitionDuration,
								onFinish: function onFinish() {
									layerInfo.container.removeChild(tile);
								}
							});
							tween(neighborTile, {
								alpha: layerInfo.alpha
							}, {
								duration: transitionDuration,
								onFinish: function onFinish() {
									// Replace in array
									var tileIndex = skyboxTiles.indexOf(tile);
									if (tileIndex !== -1) {
										skyboxTiles[tileIndex] = neighborTile;
									}
								}
							});
						}
					}
				}
			};
		}(radius), radius * baseDelay);
	}
}
// Start continuous skybox transitions with depth-aware timing
var skyboxTransitionTimer = LK.setInterval(function () {
	createSkyboxTransition();
}, 2000 + Math.random() * 3000); // Every 2-5 seconds for more subtle effect
// NPC spawning system for world building
var npcSpawnTimer = LK.setInterval(function () {
	// Randomly spawn new NPCs occasionally
	if (Math.random() < 0.3 && skyboxNPCs.length < 20) {
		// 30% chance, max 20 NPCs
		var randomLayerIndex = Math.floor(Math.random() * skyboxLayers.length);
		var layer = skyboxLayers[randomLayerIndex];
		var layerTint = 0x888888 + randomLayerIndex * 0x222222;
		var layerScale = layer.scale;
		var newNPC = LK.getAsset('npc1', {
			anchorX: 0.5,
			anchorY: 0.5,
			x: Math.random() * 2048,
			y: Math.random() * 2732,
			scaleX: layerScale * 0.8,
			scaleY: layerScale * 0.8,
			alpha: layer.alpha * 0.7,
			tint: layerTint
		});
		// NPC movement properties
		newNPC.moveSpeed = 0.5 + Math.random() * 1.0;
		newNPC.direction = Math.random() * Math.PI * 2;
		newNPC.directionChangeTimer = 0;
		newNPC.directionChangeInterval = 3000 + Math.random() * 4000;
		newNPC.layerIndex = randomLayerIndex;
		newNPC.baseX = newNPC.x;
		newNPC.baseY = newNPC.y;
		layer.container.addChild(newNPC);
		skyboxNPCs.push(newNPC);
		// Create subtle spawn effect
		var spawnEffect = LK.getAsset('fire', {
			anchorX: 0.5,
			anchorY: 0.5,
			x: newNPC.x,
			y: newNPC.y,
			alpha: 0.3,
			tint: 0x88CCFF,
			scaleX: 0.1,
			scaleY: 0.1
		});
		layer.container.addChild(spawnEffect);
		tween(spawnEffect, {
			alpha: 0,
			scaleX: 0.5,
			scaleY: 0.5
		}, {
			duration: 800,
			onFinish: function onFinish() {
				layer.container.removeChild(spawnEffect);
			}
		});
	}
}, 10000 + Math.random() * 15000); // Every 10-25 seconds
// Add parallax movement system for raycasted depth effect
var parallaxMovement = {
	x: 0,
	y: 0,
	speed: 0.5
};
// Update parallax movement based on virtual camera movement
var parallaxUpdateTimer = LK.setInterval(function () {
	// Simulate subtle camera movement for atmospheric depth
	parallaxMovement.x += (Math.random() - 0.5) * parallaxMovement.speed;
	parallaxMovement.y += (Math.random() - 0.5) * parallaxMovement.speed * 0.3;
	// Apply parallax movement to each layer
	for (var layerIndex = 0; layerIndex < skyboxLayers.length; layerIndex++) {
		var layer = skyboxLayers[layerIndex];
		var parallaxScale = layer.parallaxSpeed;
		// Calculate layer offset based on parallax speed
		var offsetX = parallaxMovement.x * parallaxScale;
		var offsetY = parallaxMovement.y * parallaxScale;
		// Apply offset to all tiles in this layer
		for (var i = 0; i < skyboxTiles.length; i++) {
			var tile = skyboxTiles[i];
			if (tile.layerIndex === layerIndex) {
				tile.x = tile.baseX + offsetX;
				tile.y = tile.baseY + offsetY;
			}
		}
	}
	// Update NPC movement and positions
	for (var i = 0; i < skyboxNPCs.length; i++) {
		var npc = skyboxNPCs[i];
		var layer = skyboxLayers[npc.layerIndex];
		var parallaxScale = layer.parallaxSpeed;
		var offsetX = parallaxMovement.x * parallaxScale;
		var offsetY = parallaxMovement.y * parallaxScale;
		// Update NPC direction change timer
		npc.directionChangeTimer += 100;
		if (npc.directionChangeTimer >= npc.directionChangeInterval) {
			npc.direction = Math.random() * Math.PI * 2;
			npc.directionChangeTimer = 0;
			npc.directionChangeInterval = 3000 + Math.random() * 4000;
		}
		// Move NPC in current direction
		npc.baseX += Math.cos(npc.direction) * npc.moveSpeed;
		npc.baseY += Math.sin(npc.direction) * npc.moveSpeed;
		// Wrap NPC around screen edges
		if (npc.baseX > 2048 + 100) {
			npc.baseX = -100;
		}
		if (npc.baseX < -100) {
			npc.baseX = 2048 + 100;
		}
		if (npc.baseY > 2732 + 100) {
			npc.baseY = -100;
		}
		if (npc.baseY < -100) {
			npc.baseY = 2732 + 100;
		}
		// Apply parallax offset to NPC position
		npc.x = npc.baseX + offsetX;
		npc.y = npc.baseY + offsetY;
	}
	// Add subtle fade/brightness variations for atmospheric realism
	if (Math.random() < 0.1) {
		// 10% chance per update
		var randomLayerIndex = Math.floor(Math.random() * skyboxLayers.length);
		var randomLayer = skyboxLayers[randomLayerIndex];
		var targetAlpha = randomLayer.alpha + (Math.random() - 0.5) * 0.1;
		targetAlpha = Math.max(0.2, Math.min(1.0, targetAlpha));
		// Smoothly transition layer alpha
		tween(randomLayer.container, {
			alpha: targetAlpha
		}, {
			duration: 3000 + Math.random() * 2000,
			easing: tween.easeInOut
		});
	}
}, 100); // Update every 100ms for smooth parallax
