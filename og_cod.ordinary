	// Initialize the storm properties
	self.windStrength = 1;
	self.alpha = 0;
	// Cloud transformation system - only active during waves
	self.cloudTransformationTimer = 0;
	self.nextTransformationTime = 30000 + Math.random() * 30000; // 30-60 seconds
	// Function to transform a cloud into an enemy
	self.transformCloudToEnemy = function () {
		// Only transform clouds if there are clouds available and a wave is in progress
		if (self.clouds.length > 0 && waveInProgress) {
			// Randomly decide if this cloud should fly into the base instead of becoming an enemy
			var shouldFlyToBase = Math.random() < 0.3; // 30% chance
			// Select a random cloud from the massive fleet
			var randomIndex = Math.floor(Math.random() * self.clouds.length);
			var selectedCloud = self.clouds[randomIndex];
			// Create dramatic transformation effect
			var transformationEffect = LK.getAsset('rangeIndicator', {
				anchorX: 0.5,
				anchorY: 0.5,
				x: selectedCloud.x,
