var atmosphericPhase = 0;
var atmosphericTimer = LK.setInterval(function () {
	atmosphericPhase += 0.1;
	var breathingAlpha = 0.02 + Math.sin(atmosphericPhase) * 0.01;
	var breathingTint = 0xFFFFFF;
	// Occasionally add color to atmospheric layer
	if (Math.random() < 0.1) {
		// 10% chance
		breathingTint = shaderColors[Math.floor(Math.random() * shaderColors.length)];
		breathingAlpha *= 2; // More visible when colored
	}
	tween(atmosphericShader, {
		alpha: breathingAlpha,
		tint: breathingTint
	}, {
		duration: 800 + Math.random() * 400,
		// Slight randomization
		easing: tween.easeInOut
	});
}, 500); // Update every 500ms for smooth breathing
