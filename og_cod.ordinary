});
var BigEnemy = Enemy.expand(function (reward) {
	var self = Enemy.call(this, 200, 0.7, reward || 25);
	// More health, slower base speed, better reward
	// Override the enemy graphic with a different image and larger size
	self.removeChild(self.children[0]); // Remove default enemy graphic
	var enemyGraphic = self.attachAsset('enemyImage3', {
		anchorX: 0.5,
		anchorY: 0.5,
		tint: 0xFF3300,
		// Reddish tint for big enemy
		scaleX: 1.8,
		scaleY: 1.8,
		alpha: 1.0,
		visible: true
	});
	// Adjust health bar position and size for bigger enemy
	self.removeChild(self.children[0]); // Remove default health bar background
	self.removeChild(self.children[0]); // Remove default health bar
	var healthBarBg = self.attachAsset('healthBarBg', {
		anchorX: 0.5,
		anchorY: 0.5,
		x: -45,
		y: -60,
		width: 90,
		height: 12,
		color: 0x000000
	});
	var healthBar = self.attachAsset('healthBar', {
		anchorX: 0.5,
		anchorY: 0.5,
		x: -45,
		y: -60,
		width: 90,
		height: 12,
		color: 0x00ff00
	});
	self.addChild(healthBarBg);
	self.addChild(healthBar);
	// Store original update function
	var originalUpdate = self.update;
	// Override update method to REMOVE erratic movement and rotation
	self.update = function () {
		if (self.isDead) {
			return;
		}
		if (self.pathIndex < gamePath.length - 1) {
			var targetPoint = gamePath[self.pathIndex + 1];
			var dx = targetPoint.x - self.x;
			var dy = targetPoint.y - self.y;
			var distance = Math.sqrt(dx * dx + dy * dy);
			if (distance < 5) {
				self.pathIndex++;
			} else {
				// Calculate base movement speed
				var vx = dx / distance * self.speed;
				var vy = dy / distance * self.speed;
				// Move enemy in a straight line, no erratic movement
				self.x += vx;
				self.y += vy;
				// Keep enemy rotation always facing the player/camera (0 radians)
				self.rotation = 0;
			}
		} else {
			self.reachedBase();
		}
		// Update health bar width based on current health
		healthBar.width = self.health / self.maxHealth * 90;
		// Heavy particle trail for big enemy
		if (self.trailTimer % 10 === 0) {
			// Less frequent but heavier trail
			// Create multiple trail particles at once for heavy effect
			for (var i = 0; i < 3; i++) {
				var heavyTrail = LK.getAsset('fire', {
					anchorX: 0.5,
					anchorY: 0.5,
					x: self.x + (Math.random() - 0.5) * 25,
					y: self.y + (Math.random() - 0.5) * 25,
					alpha: 0.5,
					tint: 0xFF3300,
					// Red trail matching enemy color
					scaleX: 0.3 + Math.random() * 0.2,
					scaleY: 0.3 + Math.random() * 0.2
				});
				game.addChild(heavyTrail);
				// Slower, heavier trail animation
				tween(heavyTrail, {
					alpha: 0,
					scaleX: 0.05,
					scaleY: 0.05,
					x: heavyTrail.x + (Math.random() - 0.5) * 40,
					y: heavyTrail.y + (Math.random() - 0.5) * 40,
					tint: 0x884400 // Fade to darker red-brown
				}, {
					duration: 2000,
					// Longer duration for heavy effect
					easing: tween.easeOut,
					onFinish: function onFinish() {
						heavyTrail.destroy();
					}
				});
			}
		}
	};
	return self;
});
var FogOfWar = Container.expand(function () {
	var self = Container.call(this);
	self.tiles = [];
	self.revealedTiles = {};
	self.tileSize = 100;
	self.visibilityRadius = 200;
	self.initialize = function (mapWidth, mapHeight) {
		// Clear any existing fog
		while (self.tiles.length > 0) {
			var tile = self.tiles.pop();
			self.removeChild(tile);
		}
		// Initialize fog grid
		for (var x = 0; x < Math.ceil(2048 / self.tileSize) + 1; x++) {
			for (var y = 0; y < Math.ceil(2732 / self.tileSize) + 1; y++) {
				var fogTile = LK.getAsset('healthBarBg', {
					anchorX: 0.0,
					anchorY: 0.0,
					x: x * self.tileSize,
					y: y * self.tileSize,
					width: self.tileSize,
					height: self.tileSize,
					alpha: 0.9,
					color: 0x888888
				});
				self.addChild(fogTile);
				self.tiles.push({
					graphic: fogTile,
					x: x,
					y: y,
					worldX: x * self.tileSize,
					worldY: y * self.tileSize
				});
			}
		}
	};
	self.updateVisibility = function (visiblePoints) {
		// Reset all tiles to hidden
		for (var i = 0; i < self.tiles.length; i++) {
			var tile = self.tiles[i];
			tile.graphic.alpha = 0.9;
		}
		// Reveal tiles near visible points
		for (var i = 0; i < visiblePoints.length; i++) {
			var point = visiblePoints[i];
			self.revealAreaAround(point.x, point.y, self.visibilityRadius);
		}
		// Illuminate the path
		for (var i = 0; i < gamePath.length; i++) {
			self.revealAreaAround(gamePath[i].x, gamePath[i].y, 100); // Smaller radius for path
		}
		// Illuminate the base with a larger radius
		if (gamePath.length > 0) {
			var basePos = gamePath[gamePath.length - 1];
			self.revealAreaAround(basePos.x, basePos.y, 220); // Larger radius for the base
		}
	};
	self.revealAreaAround = function (x, y, radius) {
		for (var i = 0; i < self.tiles.length; i++) {
			var tile = self.tiles[i];
			var dx = Math.abs(tile.worldX + self.tileSize / 2 - x);
			var dy = Math.abs(tile.worldY + self.tileSize / 2 - y);
			var distance = Math.sqrt(dx * dx + dy * dy);
			// If within visibility radius
			if (distance < radius) {
				// Calculate alpha based on distance (closer = more transparent)
				var alpha = distance / radius;
				// Only update if new alpha would be lower (more transparent)
				if (alpha < tile.graphic.alpha) {
					tile.graphic.alpha = alpha;
				}
			}
		}
	};
	return self;
});
var IsometricTile = Container.expand(function (type, gridX, gridY) {
	var self = Container.call(this);
	self.type = type || 'grass';
	self.gridX = gridX;
	self.gridY = gridY;
	// Create the tile visual
	var tileAsset;
	if (self.type === 'path') {
		tileAsset = 'pathTile';
	} else {
		// Randomly select one of three grass tile variants
		var grassVariant = Math.floor(Math.random() * 3) + 1;
		tileAsset = 'grassTile' + grassVariant;
	}
	var tileGraphic = self.attachAsset(tileAsset, {
		anchorX: 0.5,
		anchorY: 0.5
	});
	// Position in isometric view
	self.updatePosition = function () {
		// Calculate isometric coordinates
		self.x = (self.gridX - self.gridY) * (tileGraphic.width / 2);
		self.y = (self.gridX + self.gridY) * (tileGraphic.height / 2);
	};
	self.updatePosition();
	// Determine if this can have a tower placed on it
	self.canPlaceTower = function () {
		return self.type === 'grass' && !self.hasTower;
	};
	self.hasTower = false;
	return self;
});
var PowerUp = Container.expand(function (type, x, y) {
	var self = Container.call(this);
	self.type = type || 'speed';
	self.x = x;
	self.y = y;
	self.collected = false;
	// Create the power-up visual
	var powerUpGraphic = self.attachAsset('powerUp', {
		anchorX: 0.5,
		anchorY: 0.5
	});
	self.update = function () {
		if (self.collected) {
			return;
		}
		// Check for collision with player or other game elements
		if (self.intersects(player)) {
			self.collect();
		}
	};
	self.collect = function () {
		self.collected = true;
		// Apply the power-up effect based on its type
		if (self.type === 'speed') {
			player.speed *= 1.5;
		} else if (self.type === 'damage') {
			player.damage *= 2;
		}
		// Play a sound effect for collecting the power-up
		LK.getSound('powerUpCollect').play();
		// Enhanced multi-layer particle collection effect
		var collectEffect = LK.getAsset('fire', {
			anchorX: 0.5,
			anchorY: 0.5,
			x: self.x,
			y: self.y,
			alpha: 0.9,
			tint: 0x00FFFF,
			scaleX: 0.5,
			scaleY: 0.5
		});
		game.addChild(collectEffect);
		// Core explosion effect
		tween(collectEffect, {
			alpha: 0,
			scaleX: 3.0,
			scaleY: 3.0,
			tint: 0xFFFF00
		}, {
			duration: 600,
			easing: tween.easeOut,
			onFinish: function onFinish() {
				collectEffect.destroy();
			}
		});
		// Spiral particle burst
		for (var i = 0; i < 8; i++) {
			(function (angle) {
				var spiralParticle = LK.getAsset('fire', {
					anchorX: 0.5,
					anchorY: 0.5,
					x: self.x,
					y: self.y,
					alpha: 0.7,
					tint: 0x88FFAA,
					scaleX: 0.3,
					scaleY: 0.3
				});
				game.addChild(spiralParticle);
				var distance = 60 + Math.random() * 40;
				var spiralX = Math.cos(angle) * distance;
				var spiralY = Math.sin(angle) * distance;
				tween(spiralParticle, {
					x: self.x + spiralX,
					y: self.y + spiralY,
					alpha: 0,
					rotation: angle + Math.PI * 2,
					scaleX: 0.1,
					scaleY: 0.1
				}, {
					duration: 500 + Math.random() * 300,
					easing: tween.easeOut,
					onFinish: function onFinish() {
						spiralParticle.destroy();
					}
				});
			})(Math.PI * 2 * i / 8);
		}
		// Power-up text indicator
		var powerText = new Text2("POWER UP!", {
			size: 36,
			fill: 0x00FFFF
		});
		powerText.anchor.set(0.5, 0.5);
		powerText.x = self.x;
		powerText.y = self.y - 40;
		powerText.alpha = 0;
		game.addChild(powerText);
		tween(powerText, {
			alpha: 1,
			y: self.y - 80,
			scaleX: 1.2,
			scaleY: 1.2
		}, {
			duration: 400,
			easing: tween.easeOut,
			onFinish: function onFinish() {
				tween(powerText, {
					alpha: 0,
					y: self.y - 120
				}, {
					duration: 400,
					onFinish: function onFinish() {
						powerText.destroy();
					}
				});
			}
		});
		self.destroy();
	};
	return self;
});
var Storyline = Container.expand(function () {
