		originalUpdate.call(self);
		// Add chaotic cloud drift patterns
		if (!self.cloudDrift) {
			self.cloudDrift = {
				phaseX: Math.random() * Math.PI * 2,
				phaseY: Math.random() * Math.PI * 2,
				intensityX: 20 + Math.random() * 30,
				intensityY: 15 + Math.random() * 20,
				turbulenceTimer: 0
			};
		}
		// Update chaotic cloud drift
		self.cloudDrift.phaseX += 0.08 + Math.random() * 0.04;
		self.cloudDrift.phaseY += 0.06 + Math.random() * 0.03;
		self.cloudDrift.turbulenceTimer++;
		// Apply atmospheric turbulence every few ticks
		if (self.cloudDrift.turbulenceTimer % 45 === 0) {
			tween(self.cloudDrift, {
				intensityX: 20 + Math.random() * 40,
				intensityY: 15 + Math.random() * 30
			}, {
				duration: 1200 + Math.random() * 800,
				easing: tween.easeInOut
			});
		}
		// Calculate chaotic offset for atmospheric cloud movement
		var atmosphericX = Math.sin(self.cloudDrift.phaseX) * self.cloudDrift.intensityX;
		var atmosphericY = Math.cos(self.cloudDrift.phaseY) * self.cloudDrift.intensityY;
		// Add wind gusts occasionally
		if (Math.random() < 0.05) {
			// 5% chance for wind gust
			var gustX = (Math.random() - 0.5) * 80;
			var gustY = (Math.random() - 0.5) * 40;
			tween(self, {
				x: self.x + gustX,
				y: self.y + gustY
			}, {
				duration: 400 + Math.random() * 300,
				easing: tween.easeOut
			});
		}
		// Keep cloud elevated above path with chaotic atmospheric movement
		self.y -= 30 + atmosphericY * 0.5; // Position higher above path with drift
		self.x += atmosphericX * 0.3; // Horizontal atmospheric drift
		// Electric trail effect for cloud enemy
		if (self.trailTimer % 6 === 0) {
			// Electric trail every 6 ticks
			var electricTrail = LK.getAsset('lightning', {
				anchorX: 0.5,
				anchorY: 0.5,
				x: self.x + (Math.random() - 0.5) * 20,
				y: self.y + (Math.random() - 0.5) * 20,
				alpha: 0.7,
				width: 3 + Math.random() * 4,
				height: 8 + Math.random() * 12,
				rotation: Math.random() * Math.PI * 2,
				tint: 0x00AAFF // Electric blue
			});
			game.addChild(electricTrail);
			// Crackling electric effect
			tween(electricTrail, {
				alpha: 0,
				scaleX: 0.1,
				scaleY: 0.1,
				rotation: electricTrail.rotation + Math.PI,
				tint: 0x88DDFF // Fade to lighter electric blue
			}, {
				duration: 800,
				easing: tween.easeOut,
				onFinish: function onFinish() {
					electricTrail.destroy();
				}
			});
		}
	};
	// Override takeDamage for electrical discharge effect
	var originalTakeDamage = self.takeDamage;
	self.takeDamage = function (damage, damageSource) {
		// Create electrical discharge when hit
		var discharge = LK.getAsset('lightning', {
			anchorX: 0.5,
			anchorY: 0.5,
			x: 0,
			y: 0,
			alpha: 0.9,
			width: 8,
			height: 40,
			rotation: Math.random() * Math.PI * 2,
			tint: 0x00AAFF
