		tween(spawnEffect, {
			alpha: 0,
			scaleX: 1.5,
			scaleY: 1.5
		}, {
			duration: 800,
			onFinish: function onFinish() {
				spawnEffect.destroy();
			}
		});
		// Spawn multiple drones
		for (var i = 0; i < self.droneCount; i++) {
			// Create a drone as a special type of bullet
			var drone = new Bullet(self.x, self.y, self.targetEnemy, self.damage, self);
			// Customize drone properties
			drone.isDrone = true;
			drone.speed = 4 + Math.random() * 3; // Increased variable speed
			drone.lifetime = 10000 + Math.random() * 5000; // Drones last 10-15 seconds
			drone.createTime = LK.ticks;
			drone.randomFactor = Math.random() * 50; // Increased erratic movement
			drone.phaseOffset = Math.random() * Math.PI * 2; // For oscillation
			// Override update method to implement erratic drone movement
			var originalUpdate = drone.update;
			drone.update = function () {
				// Drone lifetime check
				if (LK.ticks - this.createTime > this.lifetime / (1000 / 60)) {
					this.destroy();
					return;
				}
				// Find a new target if current one is dead
				if (!this.target || this.target.isDead) {
					// Try to find a new target from enemies array
					for (var i = 0; i < enemies.length; i++) {
						if (!enemies[i].isDead) {
							this.target = enemies[i];
							break;
						}
					}
					// No targets found, return to base with spiral pattern
					if (!this.target || this.target.isDead) {
						var angle = (LK.ticks - this.createTime) / 20;
						var distance = Math.max(50, (this.lifetime - (LK.ticks - this.createTime) * (1000 / 60)) / 100);
						this.x = self.x + Math.cos(angle) * distance;
						this.y = self.y + Math.sin(angle) * distance;
						return;
					}
				}
				// Calculate direction to target
				var dx = this.target.x - this.x;
				var dy = this.target.y - this.y;
				var distance = Math.sqrt(dx * dx + dy * dy);
				// Erratic movement pattern using sine/cosine
				var time = LK.ticks / 10;
				var erraticX = Math.sin(time * 1.5 + this.phaseOffset) * this.randomFactor;
				var erraticY = Math.cos(time * 1.7 + this.phaseOffset) * this.randomFactor;
				// Move towards target with erratic component
				if (distance < 5) {
					// Deal damage when reaching target
					this.target.takeDamage(this.damage, this.damageSource);
					// Create hit effect
					var hitEffect = LK.getAsset('fire', {
						anchorX: 0.5,
						anchorY: 0.5,
						x: this.x,
						y: this.y,
						alpha: 0.7,
						tint: 0x55FF55,
						scaleX: 0.5,
						scaleY: 0.5
					});
					game.addChild(hitEffect);
					tween(hitEffect, {
						alpha: 0,
						scaleX: 1.0,
						scaleY: 1.0
					}, {
						duration: 300,
						onFinish: function onFinish() {
							hitEffect.destroy();
						}
					});
					// Find a new target after hitting
					this.target = null;
				} else {
					// Move toward target with erratic component
					this.x += dx / distance * this.speed + erraticX * 0.5;
					this.y += dy / distance * this.speed + erraticY * 0.5;
					// Leave trail effect
					if (Math.random() < 0.1) {
						var trail = LK.getAsset('fire', {
							anchorX: 0.5,
							anchorY: 0.5,
