			});
			game.addChild(upgradeEffect);
			tween(upgradeEffect, {
				alpha: 0,
				scaleX: 1.5,
				scaleY: 1.5
			}, {
				duration: 500,
				onFinish: function onFinish() {
					upgradeEffect.destroy();
				}
			});
			return true;
		}
		return false;
	};
	return self;
});
var EmTower = Tower.expand(function (gridX, gridY) {
	var self = Tower.call(this, gridX, gridY);
	self.level = 1;
	self.damage = 20; // Lower damage than regular tower
	self.range = 200; // Larger range
	self.fireRate = 1500; // Slower fire rate
	self.slowEffect = 0.6; // Slows enemies to 60% of their normal speed
	self.slowDuration = 3000; // Slow effect lasts for 3 seconds
	self.cost = 65; // Different cost from regular tower
	// Override the tower graphic with a different color
	self.removeChild(self.children[0]); // Remove default tower graphic
	var towerGraphic = self.attachAsset('emptower', {
		anchorX: 0.5,
		anchorY: 1.0,
		tint: 0x00AAFF,
		// Blue tint for EM tower
		scaleX: 2.4,
		scaleY: 2.4
	});
	// Override shoot method for slowing effect
	self.shoot = function () {
		if (!self.targetEnemy || self.targetEnemy.isDead) {
			return false;
		}
		// Apply slowing effect to the target
		self.applySlowEffect(self.targetEnemy);
		// Create visual effect for EM pulse
		var emPulse = LK.getAsset('rangeIndicator', {
			anchorX: 0.5,
			anchorY: 0.5,
			x: self.x,
			y: self.y,
			alpha: 0.3,
			tint: 0x00AAFF,
			scaleX: 0.1,
			scaleY: 0.1
		});
		game.addChild(emPulse);
		// Expand pulse effect
		tween(emPulse, {
			alpha: 0,
			scaleX: self.range / 100,
			scaleY: self.range / 100
		}, {
			duration: 800,
			onFinish: function onFinish() {
				emPulse.destroy();
			}
		});
		getRandomShootSound().play();
		LK.effects.flashObject(towerGraphic, 0x00FFFF, 100);
		return true;
	};
	// New method to apply slow effect to enemy
	self.applySlowEffect = function (enemy) {
		// Store original speed if not already slowed
		if (!enemy.originalSpeed) {
			enemy.originalSpeed = enemy.speed;
		}
		// Apply slow effect
		enemy.speed = enemy.originalSpeed * self.slowEffect;
		// Visual indicator of slow effect
		enemy.tint = 0x00AAFF;
		// Clear any existing slow timeout
		if (enemy.slowTimeout) {
			LK.clearTimeout(enemy.slowTimeout);
		}
		// Set timeout to restore original speed
		enemy.slowTimeout = LK.setTimeout(function () {
			enemy.speed = enemy.originalSpeed;
			enemy.tint = 0xFFFFFF;
			enemy.slowTimeout = null;
		}, self.slowDuration);
	};
	// Override findTarget to affect all enemies in range
	self.findTarget = function (enemies) {
		self.targetEnemy = null;
		var hasTargets = false;
		// Find all enemies in range to apply slow effect
		for (var i = 0; i < enemies.length; i++) {
			var enemy = enemies[i];
			if (enemy.isDead) {
				continue;
			}
			var dx = enemy.x - self.x;
			var dy = enemy.y - self.y;
			var distance = Math.sqrt(dx * dx + dy * dy);
			if (distance <= self.range) {
				// Set as target for visual purposes
				if (!self.targetEnemy) {
					self.targetEnemy = enemy;
				}
				hasTargets = true;
			}
		}
		return hasTargets;
	};
	// Override upgrade to improve slow effect
	self.upgrade = function () {
		if (gold >= self.getUpgradeCost()) {
			gold -= self.getUpgradeCost();
			goldText.setText("Gold: " + gold);
			self.level++;
			self.damage = Math.floor(self.damage * 1.5);
			self.range += 30;
			self.slowEffect *= 0.8; // Enemy moves at 80% of previously slowed speed
			self.slowDuration *= 1.5; // Slow effect lasts 50% longer
			self.fireRate *= 0.85;
			// Update range indicator
			self.children[0].width = self.range * 2;
			self.children[0].height = self.range * 2;
			towerGraphic.tint = self.level === 2 ? 0x0088CC : 0x0066AA;
			LK.effects.flashObject(self, 0x00FFFF, 300);
			// Add particle effect for tower upgrade
			var upgradeEffect = LK.getAsset('fire', {
				anchorX: 0.5,
				anchorY: 0.5,
				x: self.x,
				y: self.y,
				alpha: 0.8,
				tint: 0x00AAFF
			});
			game.addChild(upgradeEffect);
			tween(upgradeEffect, {
				alpha: 0,
				scaleX: 1.5,
				scaleY: 1.5
			}, {
				duration: 500,
				onFinish: function onFinish() {
					upgradeEffect.destroy();
				}
			});
			return true;
		}
		return false;
	};
	return self;
});
var DroneFactory = Tower.expand(function (gridX, gridY) {
	var self = Tower.call(this, gridX, gridY);
	self.level = 1;
	self.damage = 30; // Medium damage per drone
	self.range = 220; // Large range for detecting enemies
	self.fireRate = 4000; // Slower fire rate but spawns multiple drones
	self.droneCount = 3; // Number of drones to spawn per firing
	self.cost = 80; // Higher cost than regular tower
