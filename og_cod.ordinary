	// Override upgrade to improve drone capabilities
	self.upgrade = function () {
		if (gold >= self.getUpgradeCost()) {
			gold -= self.getUpgradeCost();
			goldText.setText("Gold: " + gold);
			self.level++;
			self.damage = Math.floor(self.damage * 1.4);
			self.range += 40;
			self.droneCount += 1; // One more drone per swarm
			self.fireRate *= 0.85;
			// Update range indicator
			self.children[0].width = self.range * 2;
			self.children[0].height = self.range * 2;
			towerGraphic.tint = self.level === 2 ? 0x33DD33 : 0x11BB11;
			LK.effects.flashObject(self, 0x55FF55, 300);
			// Add particle effect for tower upgrade
			var upgradeEffect = LK.getAsset('fire', {
				anchorX: 0.5,
				anchorY: 0.5,
				x: self.x,
				y: self.y,
				alpha: 0.8,
				tint: 0x55FF55
			});
			game.addChild(upgradeEffect);
			tween(upgradeEffect, {
				alpha: 0,
				scaleX: 1.5,
				scaleY: 1.5
			}, {
				duration: 500,
				onFinish: function onFinish() {
					upgradeEffect.destroy();
				}
			});
			return true;
		}
		return false;
	};
	return self;
});
var DefenseGrid = Tower.expand(function (gridX, gridY) {
	var self = Tower.call(this, gridX, gridY);
	self.level = 1;
	self.damage = 0; // No direct damage
	self.range = 250; // Large force field range
	self.fireRate = 1000; // Continuous force field activation
	self.slowEffect = 0.2; // Enemies move at 20% speed in force field
	self.slowDuration = 2000; // Effect lasts 2 seconds after leaving field
	self.cost = 120; // Expensive defensive tower
	self.forceFieldActive = false;
	// Override the tower graphic with defense grid appearance
	self.removeChild(self.children[0]); // Remove default tower graphic
	var towerGraphic = self.attachAsset('emptower', {
		anchorX: 0.5,
		anchorY: 1.0,
		tint: 0x00FF88,
		// Green-cyan tint for defense grid
		scaleX: 2.8,
		scaleY: 2.8
	});
	// Create permanent force field indicator
	var forceField = LK.getAsset('rangeIndicator', {
		anchorX: 0.5,
		anchorY: 0.5,
		x: 0,
		y: 0,
		alpha: 0.15,
		tint: 0x00FF88,
		width: self.range * 2,
		height: self.range * 2
	});
	self.addChild(forceField);
	self.forceField = forceField;
	// Create pulsing force field effect
	var _pulseForceField = function pulseForceField() {
		if (self.forceField && self.forceField.parent) {
			tween(self.forceField, {
				alpha: 0.25,
				scaleX: 1.05,
				scaleY: 1.05
			}, {
				duration: 800,
				easing: tween.easeInOut,
				onFinish: function onFinish() {
					if (self.forceField && self.forceField.parent) {
						tween(self.forceField, {
							alpha: 0.15,
							scaleX: 1.0,
							scaleY: 1.0
						}, {
							duration: 800,
							easing: tween.easeInOut,
							onFinish: _pulseForceField
						});
					}
				}
			});
		}
	};
	_pulseForceField();
	// Override shoot method for force field effect
	self.shoot = function () {
		// Defense grid doesn't shoot projectiles, it maintains force field
		self.forceFieldActive = true;
		// Create force field activation ripple
		var activationRipple = LK.getAsset('rangeIndicator', {
			anchorX: 0.5,
			anchorY: 0.5,
			x: 0,
			y: 0,
			alpha: 0.4,
			tint: 0x00FFFF,
			width: 50,
			height: 50
		});
		self.addChild(activationRipple);
		// Expand activation ripple
		tween(activationRipple, {
			alpha: 0,
			width: self.range * 2.2,
			height: self.range * 2.2
		}, {
			duration: 1000,
			easing: tween.easeOut,
			onFinish: function onFinish() {
				self.removeChild(activationRipple);
			}
		});
		// Apply force field effect to all enemies in range
		self.applyForceFieldToEnemies();
		LK.effects.flashObject(towerGraphic, 0x00FFFF, 200);
		return true;
	};
	// New method to apply force field effect to all enemies in range
	self.applyForceFieldToEnemies = function () {
		for (var i = 0; i < enemies.length; i++) {
			var enemy = enemies[i];
			if (enemy.isDead) {
				continue;
			}
			var dx = enemy.x - self.x;
			var dy = enemy.y - self.y;
			var distance = Math.sqrt(dx * dx + dy * dy);
			if (distance <= self.range) {
				self.applySlowEffect(enemy);
			}
		}
	};
	// Method to apply force field slow effect
	self.applySlowEffect = function (enemy) {
		// Store original speed if not already affected
		if (!enemy.originalSpeed) {
			enemy.originalSpeed = enemy.speed;
		}
		// Apply severe slow effect in force field
		enemy.speed = enemy.originalSpeed * self.slowEffect;
		// Visual indicator of force field effect - blue glow
		if (!enemy.forceFieldEffect) {
			var fieldEffect = LK.getAsset('rangeIndicator', {
				anchorX: 0.5,
				anchorY: 0.5,
				x: 0,
				y: 0,
				alpha: 0.3,
				tint: 0x00AAFF,
				width: 60,
				height: 60
			});
			enemy.addChild(fieldEffect);
			enemy.forceFieldEffect = fieldEffect;
			// Pulsing effect while in force field
			var _pulseFieldEffect = function pulseFieldEffect() {
				if (enemy.forceFieldEffect && enemy.forceFieldEffect.parent) {
					tween(enemy.forceFieldEffect, {
						alpha: 0.5,
						scaleX: 1.2,
						scaleY: 1.2
					}, {
						duration: 400,
						onFinish: function onFinish() {
							if (enemy.forceFieldEffect && enemy.forceFieldEffect.parent) {
								tween(enemy.forceFieldEffect, {
									alpha: 0.2,
									scaleX: 1.0,
									scaleY: 1.0
								}, {
									duration: 400,
									onFinish: _pulseFieldEffect
								});
							}
						}
					});
				}
			};
			_pulseFieldEffect();
		}
		// Clear any existing force field timeout
		if (enemy.forceFieldTimeout) {
			LK.clearTimeout(enemy.forceFieldTimeout);
		}
		// Mark enemy as being in force field
		enemy.inForceField = true;
		enemy.forceFieldSource = self;
		// Set timeout to restore speed after leaving field
		enemy.forceFieldTimeout = LK.setTimeout(function () {
			if (enemy.originalSpeed) {
				enemy.speed = enemy.originalSpeed;
			}
			if (enemy.forceFieldEffect) {
				enemy.removeChild(enemy.forceFieldEffect);
				enemy.forceFieldEffect = null;
			}
			enemy.inForceField = false;
			enemy.forceFieldTimeout = null;
		}, self.slowDuration);
	};
	// Override findTarget to continuously affect enemies in range
	self.findTarget = function (enemies) {
		var hasTargets = false;
		self.applyForceFieldToEnemies();
		return true; // Always return true to maintain force field
	};
	// Override upgrade to improve force field capabilities
	self.upgrade = function () {
		if (gold >= self.getUpgradeCost()) {
			gold -= self.getUpgradeCost();
			goldText.setText("Gold: " + gold);
			self.level++;
			// Improve force field properties
			self.range += 40;
			self.slowEffect *= 0.7; // Enemy moves even slower (70% of previous speed)
			self.slowDuration *= 1.3; // Effect lasts 30% longer
			self.fireRate *= 0.9;
			// Update force field visual
			self.forceField.width = self.range * 2;
			self.forceField.height = self.range * 2;
			towerGraphic.tint = self.level === 2 ? 0x00CC66 : 0x00AA44;
			// Create upgrade effect with expanding rings
			var upgradeRing1 = LK.getAsset('rangeIndicator', {
				anchorX: 0.5,
				anchorY: 0.5,
				x: 0,
				y: 0,
				alpha: 0.6,
				tint: 0x00FF88,
				width: self.range * 1.5,
				height: self.range * 1.5
			});
			self.addChild(upgradeRing1);
			tween(upgradeRing1, {
				alpha: 0,
				width: self.range * 2.5,
				height: self.range * 2.5
			}, {
				duration: 1000,
				easing: tween.easeOut,
				onFinish: function onFinish() {
					self.removeChild(upgradeRing1);
				}
			});
			// Secondary upgrade ring
			LK.setTimeout(function () {
				var upgradeRing2 = LK.getAsset('rangeIndicator', {
					anchorX: 0.5,
					anchorY: 0.5,
					x: 0,
					y: 0,
					alpha: 0.4,
					tint: 0x00AAFF,
					width: self.range * 1.8,
					height: self.range * 1.8
				});
				self.addChild(upgradeRing2);
				tween(upgradeRing2, {
					alpha: 0,
					width: self.range * 2.8,
					height: self.range * 2.8
				}, {
					duration: 800,
					easing: tween.easeOut,
					onFinish: function onFinish() {
						self.removeChild(upgradeRing2);
					}
				});
			}, 300);
			LK.effects.flashObject(self, 0x00FF88, 400);
			return true;
		}
		return false;
	};
	return self;
});
var BombTower = Tower.expand(function (gridX, gridY) {
	var self = Tower.call(this, gridX, gridY);
	self.level = 1;
	self.damage = 80; // Higher damage than regular tower
	self.range = 180; // Larger range
	self.fireRate = 2500; // Much slower fire rate
	self.splashRadius = 80; // Area of effect damage
	self.cost = 75; // More expensive
	// Override the tower graphic with a different color
	self.removeChild(self.children[0]); // Remove default tower graphic
	var towerGraphic = self.attachAsset('towerImage', {
		anchorX: 0.5,
		anchorY: 1.0,
		tint: 0xFF8800,
		// Orange tint for bomb tower
		scaleX: 2.4,
		scaleY: 2.4
	});
	// Override shoot method for area damage
	self.shoot = function () {
		if (!self.targetEnemy || self.targetEnemy.isDead) {
			return false;
		}
		// Calculate direction to target for angled effects
		var dx = self.targetEnemy.x - self.x;
		var dy = self.targetEnemy.y - self.y;
		var angle = Math.atan2(dy, dx);
		// Special bomb bullet
		var bullet = new Bullet(self.x, self.y, self.targetEnemy, self.damage, self);
		bullet.isBomb = true;
		bullet.splashRadius = self.splashRadius;
		game.addChild(bullet);
		bullets.push(bullet);
		// Explosion sound
		getRandomShootSound().play();
		// Keep bomb tower stationary - no recoil movement
		// Add barrel flash effect
		var barrelFlash = LK.getAsset('fire', {
			anchorX: 0.5,
			anchorY: 0.5,
			x: self.x + Math.cos(angle) * 30,
			y: self.y + Math.sin(angle) * 30,
			rotation: angle,
			alpha: 0.9,
			tint: 0xFF8800
		});
		game.addChild(barrelFlash);
		// Animate barrel flash
		tween(barrelFlash, {
			alpha: 0,
			scaleX: 2.0,
			scaleY: 2.0
		}, {
			duration: 200,
			onFinish: function onFinish() {
				barrelFlash.destroy();
			}
		});
		// Add smoke trail effect
		var smokeRing = LK.getAsset('fire', {
			anchorX: 0.5,
			anchorY: 0.5,
			x: self.x + Math.cos(angle) * 15,
			y: self.y + Math.sin(angle) * 15,
			alpha: 0.7,
			tint: 0x222222 // Smoke color
		});
		game.addChild(smokeRing);
		// Animate smoke ring
		tween(smokeRing, {
			x: self.x + Math.cos(angle) * 40,
			y: self.y + Math.sin(angle) * 40,
			alpha: 0,
			scaleX: 2.5,
			scaleY: 2.5
		}, {
			duration: 900,
			onFinish: function onFinish() {
				smokeRing.destroy();
			}
		});
		// Create shockwave effect
		var shockwave = LK.getAsset('rangeIndicator', {
			anchorX: 0.5,
			anchorY: 0.5,
			x: self.x,
			y: self.y,
			alpha: 0.5,
			tint: 0xFF3300,
			width: 50,
			height: 50
		});
		game.addChild(shockwave);
		tween(shockwave, {
			alpha: 0,
			width: 150,
			height: 150
		}, {
			duration: 500,
			onFinish: function onFinish() {
				shockwave.destroy();
			}
		});
		LK.effects.flashObject(towerGraphic, 0xFF8800, 150);
		return true;
	};
	// Override upgrade to improve splash damage
	self.upgrade = function () {
		if (gold >= self.getUpgradeCost()) {
			gold -= self.getUpgradeCost();
			goldText.setText("Gold: " + gold);
			self.level++;
			self.damage = Math.floor(self.damage * 1.8);
			self.range += 30;
			self.splashRadius += 25;
			self.fireRate *= 0.85;
			// Update range indicator
			self.children[0].width = self.range * 2;
			self.children[0].height = self.range * 2;
			towerGraphic.tint = self.level === 2 ? 0xFF5500 : 0xFF3300;
			LK.effects.flashObject(self, 0xFF8800, 300);
			// Add particle effect for tower upgrade
			var upgradeEffect = LK.getAsset('fire', {
				anchorX: 0.5,
				anchorY: 0.5,
				x: self.x,
				y: self.y,
				alpha: 0.8,
				tint: 0xFF8800
			});
			game.addChild(upgradeEffect);
			tween(upgradeEffect, {
				alpha: 0,
				scaleX: 2.0,
				scaleY: 2.0
			}, {
				duration: 600,
				onFinish: function onFinish() {
					upgradeEffect.destroy();
				}
			});
			return true;
		}
		return false;
	};
	return self;
});
