resourceTowerButton.onClick = function () {
	if (gold >= 60 && !isPlacingTower) {
		// Resource tower purchase animation
		tween(resourceTowerButton, {
			scaleX: 0.95,
			scaleY: 0.95
		}, {
			duration: 100,
			onFinish: function onFinish() {
				tween(resourceTowerButton, {
					scaleX: 1.0,
					scaleY: 1.0
				}, {
					duration: 150,
					easing: tween.elasticOut
				});
			}
		});
		isPlacingTower = true;
		selectedTowerIndex = 7; // Resource tower index
		// Create tower placement indicator
		placingTowerIndicator = LK.getAsset('tower', {
			anchorX: 0.5,
			anchorY: 1.0,
			alpha: 0.5,
			tint: 0x708090 // Gray tint for resource tower
		});
		game.addChild(placingTowerIndicator);
		// Deselect any selected tower
		if (selectedTower) {
			selectedTower.deselect();
			selectedTower = null;
		}
	}
};
