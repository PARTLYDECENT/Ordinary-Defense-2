			alpha: 0,
			width: self.range * 2,
			height: self.range * 2
		}, {
			duration: 800,
			onFinish: function onFinish() {
				self.removeChild(collectionEffect);
			}
		});
		// Show floating stone collection text
		var stoneText = new Text2("+" + self.stonePerCollection + " Stone", {
			size: 32,
			fill: 0x708090
		});
		stoneText.anchor.set(0.5, 0.5);
		stoneText.x = 0;
		stoneText.y = -60;
		self.addChild(stoneText);
		// Animate floating text
		tween(stoneText, {
			y: -100,
			alpha: 0
