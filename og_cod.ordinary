		var cloudTint = wickedColors[Math.floor(Math.random() * wickedColors.length)];
		cloud.tint = cloudTint;
		cloud._originalTint = cloudTint;
		cloud.speedX = (Math.random() * 3 - 1.5) * 2.0; // Varied speeds for massive fleet movement
		cloud.turbulence = 0.3 + Math.random() * 1.2; // Wide range of turbulence for fleet diversity
		cloud.turbPhase = Math.random() * Math.PI * 2; // Starting phase for turbulence
		cloud.lightningProbability = 0.4 + Math.random() * 0.6; // Varied lightning probability across fleet
		cloud.wickedIntensity = Math.random(); // Individual wicked factor for each cloud
		cloud.fleetLayer = Math.floor(i / 12); // Assign clouds to different fleet layers (0, 1, 2)
		cloud.baseY = cloud.y; // Store base Y position for layer movement
		self.cloudsContainer.addChild(cloud);
