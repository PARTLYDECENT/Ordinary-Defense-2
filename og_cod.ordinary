var ResourceTower = Tower.expand(function (gridX, gridY) {
	var self = Tower.call(this, gridX, gridY);
	self.level = 1;
	self.damage = 0; // No direct damage - this is a resource tower
	self.range = 120; // Collection range
	self.fireRate = 3000; // Collect every 3 seconds
	self.cost = 60; // Cost to build
	self.stonePerCollection = 3; // Stone collected per cycle
	// Override the tower graphic with resource tower appearance
	self.removeChild(self.children[0]); // Remove default tower graphic
	var towerGraphic = self.attachAsset('resourceTower', {
		anchorX: 0.5,
		anchorY: 1.0,
