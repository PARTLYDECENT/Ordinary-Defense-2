var bombTowerButton = new Button('Bomb Tower\n75g', 400, 100, 0xFF8800, 'bombTowerButton');
sidebarContainer.addChild(bombTowerButton);
bombTowerButton.x = 25;
bombTowerButton.y = 320; // Position in sidebar
bombTowerButton.onClick = function () {
	if (gold >= 75 && !isPlacingTower) {
		// Explosive button animation for bomb tower
		tween(bombTowerButton, {
			scaleX: 0.85,
			scaleY: 0.85
		}, {
			duration: 60,
			onFinish: function onFinish() {
				tween(bombTowerButton, {
					scaleX: 1.15,
					scaleY: 1.15
				}, {
					duration: 100,
					onFinish: function onFinish() {
						tween(bombTowerButton, {
							scaleX: 1.0,
							scaleY: 1.0
						}, {
							duration: 120,
							easing: tween.bounceOut
						});
					}
				});
			}
		});
		// Explosive purchase effect with expanding rings
		var explosionCore = LK.getAsset('fire', {
			anchorX: 0.5,
			anchorY: 0.5,
			x: bombTowerButton.x,
			y: bombTowerButton.y,
			alpha: 0.9,
			tint: 0xFF8800,
			scaleX: 0.3,
			scaleY: 0.3
		});
		LK.gui.top.addChild(explosionCore);
		tween(explosionCore, {
			alpha: 0,
			scaleX: 2.5,
			scaleY: 2.5
		}, {
			duration: 800,
			easing: tween.easeOut,
			onFinish: function onFinish() {
				LK.gui.top.removeChild(explosionCore);
			}
		});
		// Secondary explosion ring
		LK.setTimeout(function () {
			var secondRing = LK.getAsset('rangeIndicator', {
				anchorX: 0.5,
				anchorY: 0.5,
				x: bombTowerButton.x,
				y: bombTowerButton.y,
				alpha: 0.4,
				tint: 0xFF4400,
				width: 80,
				height: 80
			});
			LK.gui.top.addChild(secondRing);
			tween(secondRing, {
				alpha: 0,
				width: 250,
				height: 250
			}, {
				duration: 600,
				onFinish: function onFinish() {
					LK.gui.top.removeChild(secondRing);
				}
			});
		}, 200);
		isPlacingTower = true;
		selectedTowerIndex = 3; // Index of the bomb tower in availableTurrets
		// Create tower placement indicator with bomb tower tint
		placingTowerIndicator = LK.getAsset('tower', {
			anchorX: 0.5,
			anchorY: 1.0,
			alpha: 0.5,
			tint: 0xFF8800 // Orange tint for bomb tower
		});
		game.addChild(placingTowerIndicator);
		// Deselect any selected tower
		if (selectedTower) {
			selectedTower.deselect();
			selectedTower = null;
		}
	} else {
		// Bomb-style error effect with multiple flashes
		var flashEffect = LK.getAsset('fire', {
			anchorX: 0.5,
			anchorY: 0.5,
			x: bombTowerButton.x,
			y: bombTowerButton.y,
			alpha: 0.8,
			tint: 0xFF2222,
			scaleX: 0.4,
			scaleY: 0.4
		});
		LK.gui.top.addChild(flashEffect);
		// Multi-flash error sequence
		var flashCount = 0;
		var maxFlashes = 3;
		var _performFlash = function performFlash() {
			if (flashCount < maxFlashes) {
				tween(flashEffect, {
					alpha: 0.9,
					scaleX: 1.2,
					scaleY: 1.2
				}, {
					duration: 100,
					onFinish: function onFinish() {
						tween(flashEffect, {
							alpha: 0.2,
							scaleX: 0.8,
							scaleY: 0.8
						}, {
							duration: 100,
							onFinish: function onFinish() {
								flashCount++;
								_performFlash();
							}
						});
					}
				});
			} else {
				tween(flashEffect, {
					alpha: 0
				}, {
					duration: 200,
					onFinish: function onFinish() {
						LK.gui.top.removeChild(flashEffect);
					}
				});
			}
		};
		_performFlash();
		// Dramatic button shake for bomb tower
		var originalX = bombTowerButton.x;
		var originalY = bombTowerButton.y;
		var shakeIntensity = 10;
		tween(bombTowerButton, {
			x: originalX - shakeIntensity,
			y: originalY + shakeIntensity / 2
		}, {
			duration: 50,
			onFinish: function onFinish() {
				tween(bombTowerButton, {
					x: originalX + shakeIntensity,
					y: originalY - shakeIntensity / 2
				}, {
					duration: 50,
					onFinish: function onFinish() {
						tween(bombTowerButton, {
							x: originalX,
							y: originalY
						}, {
							duration: 100,
							easing: tween.easeOut
						});
					}
				});
			}
		});
	}
};
// Next wave button - moved to sidebar
var nextWaveButton = new Button('Next\nWave', 400, 100, 0x44cc44, 'basicTurretButton');
sidebarContainer.addChild(nextWaveButton);
nextWaveButton.x = 25;
nextWaveButton.y = 620; // Position in sidebar below resource tower button
nextWaveButton.onClick = function () {
	if (!waveInProgress) {
		startNextWave();
	}
};
// Tower UI (upgrade/sell - initially hidden)
var towerUI = new Container();
game.addChild(towerUI);
towerUI.visible = false;
upgradeButton = new Button('Upgrade', 120, 50, 0x44cc44);
upgradeButton.x = 0;
upgradeButton.y = 0;
towerUI.addChild(upgradeButton);
upgradeButton.onClick = function () {
	if (selectedTower) {
		if (selectedTower.upgrade()) {
			// Update UI
			upgradeButton.setText('Upgrade (' + selectedTower.getUpgradeCost() + 'g)');
			sellButton.setText('Sell (' + selectedTower.sellValue() + 'g)');
			// Check if player has enough gold for next upgrade
			upgradeButton.setEnabled(gold >= selectedTower.getUpgradeCost());
		}
	}
};
sellButton = new Button('Sell', 120, 50, 0xcc4444);
sellButton.x = 0;
sellButton.y = 60;
towerUI.addChild(sellButton);
sellButton.onClick = function () {
	if (selectedTower) {
		// Give gold for selling
		gold += selectedTower.sellValue();
		goldText.setText("Gold: " + gold);
		// Get the tile this tower is on
		for (var i = 0; i < tileMap.length; i++) {
			var tile = tileMap[i];
			if (tile.gridX === selectedTower.gridX && tile.gridY === selectedTower.gridY) {
				tile.hasTower = false;
				break;
			}
		}
		// Remove tower
		var towerIndex = towers.indexOf(selectedTower);
		if (towerIndex !== -1) {
			towers.splice(towerIndex, 1);
		}
		selectedTower.destroy();
		// Hide UI
		hideTowerUI();
		selectedTower = null;
		// Update build button state
		buildTowerButton.setEnabled(true);
	}
};
// Path coordinates for the map
var pathCoords = [];
// Example: To add a new world, create a new file (e.g. world_desert.js) and define a function like this:
// function createMap_desert() {
//   // ... define tileMap, pathCoords, gamePath, basePosition for the desert map ...
//   // You can copy the structure of createMap() and change the path, tiles, etc.
//   // Then, in the main file, add:
//   // availableWorlds.push({ name: "Desert", loader: function() { createMap_desert(); } });
// }
function createMap() {
	// Clear any existing map
	for (var i = 0; i < tileMap.length; i++) {
		game.removeChild(tileMap[i]);
	}
	tileMap = [];
	// Define a sophisticated winding path with multiple strategic chokepoints
	pathCoords = [
	// Main entry from top-left
	{
		x: 0,
		y: 2
	}, {
		x: 1,
		y: 2
	}, {
		x: 2,
		y: 2
	}, {
		x: 3,
		y: 2
	}, {
		x: 4,
		y: 2
	},
	// First curve down
	{
		x: 5,
		y: 2
	}, {
		x: 5,
		y: 3
	}, {
		x: 5,
		y: 4
	}, {
		x: 5,
		y: 5
	},
	// Sharp turn right creating first chokepoint
	{
		x: 6,
		y: 5
	}, {
		x: 7,
		y: 5
	}, {
		x: 8,
		y: 5
	}, {
		x: 9,
		y: 5
	}, {
		x: 10,
		y: 5
	},
	// Curve up creating strategic bend
	{
		x: 10,
		y: 4
	}, {
		x: 10,
		y: 3
	}, {
		x: 10,
		y: 2
	}, {
		x: 10,
		y: 1
	},
	// Sharp turn left at top
	{
		x: 9,
		y: 1
	}, {
		x: 8,
		y: 1
	}, {
		x: 7,
		y: 1
	},
	// Drop down creating second strategic chokepoint
	{
		x: 7,
		y: 2
	}, {
		x: 7,
		y: 3
	}, {
		x: 7,
		y: 4
	},
	// Move left through center
	{
		x: 6,
		y: 4
	}, {
		x: 5,
		y: 4
	}, {
		x: 4,
		y: 4
	}, {
		x: 3,
		y: 4
	}, {
		x: 2,
		y: 4
	},
	// Curve down for strategic positioning
	{
		x: 2,
		y: 5
	}, {
		x: 2,
		y: 6
	}, {
		x: 2,
		y: 7
	}, {
		x: 2,
		y: 8
	},
	// Sharp right turn creating third chokepoint
	{
		x: 3,
		y: 8
	}, {
		x: 4,
		y: 8
	}, {
		x: 5,
		y: 8
	}, {
		x: 6,
		y: 8
	}, {
		x: 7,
		y: 8
	}, {
		x: 8,
		y: 8
	},
	// Final approach curve
	{
		x: 8,
		y: 9
	}, {
		x: 8,
		y: 10
	}, {
		x: 8,
		y: 11
	}, {
		x: 8,
		y: 12
	}, {
		x: 8,
		y: 13
	}];
	// Secondary entry path from right side creating dual-threat scenario
	var secondPath = [{
		x: 13,
		y: 6
	}, {
		x: 12,
		y: 6
	}, {
		x: 11,
		y: 6
	}, {
		x: 10,
		y: 6
	}, {
		x: 9,
		y: 6
	},
	// Merge with main path
	{
		x: 9,
		y: 7
	}, {
		x: 9,
		y: 8
	}, {
		x: 8,
		y: 8
	}];
	// Third path from bottom creating triple threat
	var thirdPath = [{
		x: 5,
		y: 13
	}, {
		x: 5,
		y: 12
	}, {
		x: 5,
		y: 11
	}, {
		x: 5,
		y: 10
	}, {
		x: 5,
		y: 9
	}, {
		x: 6,
		y: 9
	}, {
		x: 7,
		y: 9
	}, {
		x: 8,
		y: 9
	}];
	// Add all paths together for complex multi-entry design
	pathCoords = pathCoords.concat(secondPath).concat(thirdPath);
	// Create tiles
	for (var x = 0; x < mapWidth; x++) {
		for (var y = 0; y < mapHeight; y++) {
			// Check if this position is on the path
			var isPath = false;
			for (var p = 0; p < pathCoords.length; p++) {
				if (pathCoords[p].x === x && pathCoords[p].y === y) {
					isPath = true;
					break;
				}
			}
			var tileType = isPath ? 'path' : 'grass';
			var tile = new IsometricTile(tileType, x, y);
			game.addChild(tile);
			tileMap.push(tile);
		}
	}
	// Determine actual path coordinates for enemies to follow
	gamePath = [];
	for (var i = 0; i < pathCoords.length; i++) {
		var pathTile = getTileAt(pathCoords[i].x, pathCoords[i].y);
		if (pathTile) {
			gamePath.push({
				x: pathTile.x,
				y: pathTile.y
			});
		}
	}
	// Add player base at the end of the path
	var basePosition = gamePath[gamePath.length - 1];
	var playerBase = LK.getAsset('baseImage', {
		anchorX: 0.5,
		anchorY: 0.5,
		scaleX: 3.0,
		scaleY: 3.0
	});
	playerBase.x = basePosition.x;
	playerBase.y = basePosition.y;
	game.addChild(playerBase);
	// Center map in game area
	var mapContainer = new Container();
	game.addChild(mapContainer);
	// Offset map to center it
	var firstTile = tileMap[0];
	var mapOffsetX = 2048 / 2 - mapWidth * 75 / 2;
	var mapOffsetY = 2732 / 2 - mapHeight * 37.5 / 2; // Center vertically
	for (var i = 0; i < tileMap.length; i++) {
		tileMap[i].x += mapOffsetX;
		tileMap[i].y += mapOffsetY;
	}
	// Fog of war removed
	// Adjust path coordinates based on offset
	for (var i = 0; i < gamePath.length; i++) {
		gamePath[i].x += mapOffsetX;
		gamePath[i].y += mapOffsetY;
	}
	// Adjust base position
	playerBase.x += mapOffsetX;
	playerBase.y += mapOffsetY;
}
function getTileAt(gridX, gridY) {
	for (var i = 0; i < tileMap.length; i++) {
		if (tileMap[i].gridX === gridX && tileMap[i].gridY === gridY) {
			return tileMap[i];
		}
	}
	return null;
}
function getGridCoordinates(x, y) {
	// Convert screen coordinates to grid coordinates
	for (var i = 0; i < tileMap.length; i++) {
		var tile = tileMap[i];
		var dx = Math.abs(tile.x - x);
		var dy = Math.abs(tile.y - y);
		// Simple check for clicking near a tile
		if (dx < 75 && dy < 37) {
			return {
				x: tile.gridX,
				y: tile.gridY,
				tile: tile
			};
		}
	}
	return null;
}
function placeTower(tile, towerIndex) {
	var turret = turretShop.purchaseTurret(towerIndex || 0);
	if (turret && tile.canPlaceTower()) {
		// Create tower based on type
		var tower;
		if (turret.type === 'bomb') {
			tower = new BombTower(tile.gridX, tile.gridY);
		} else if (turret.type === 'em') {
			tower = new EmTower(tile.gridX, tile.gridY);
		} else if (turret.type === 'drone') {
			tower = new DroneFactory(tile.gridX, tile.gridY);
		} else if (turret.type === 'defensegrid') {
			tower = new DefenseGrid(tile.gridX, tile.gridY);
		} else if (turret.type === 'resource') {
			tower = new ResourceTower(tile.gridX, tile.gridY);
		} else {
			tower = new Tower(tile.gridX, tile.gridY);
		}
		tower.x = tile.x;
		tower.y = tile.y;
		game.addChild(tower);
		towers.push(tower);
		// Mark tile as having a tower
		tile.hasTower = true;
		// Play sound
		LK.getSound('towerPlace').play();
		// Play lore narration only if it hasn't been played 2 times already
		if (lore1PlayCount < 2) {
			LK.getSound('lore1').play();
			lore1PlayCount++;
		}
		// Increment towers placed counter
		towersPlacedCount++;
		// Play lore3 sound after 6 towers have been placed
		if (towersPlacedCount === 6 && lore3PlayCount === 0) {
			LK.getSound('lore3').play();
			lore3PlayCount++;
		}
		// Add particle effect for tower placement
		var placeEffect = LK.getAsset('fire', {
			anchorX: 0.5,
			anchorY: 0.5,
			x: tower.x,
			y: tower.y,
			alpha: 0.8
		});
		game.addChild(placeEffect);
		tween(placeEffect, {
			alpha: 0,
			scaleX: 1.5,
			scaleY: 1.5
		}, {
			duration: 500,
			onFinish: function onFinish() {
				placeEffect.destroy();
			}
		});
		// Fog of war removed
		return true;
	}
	return false;
}
function startNextWave() {
	waveNumber++;
	waveText.setText("Level: " + currentLevel + " Wave: " + waveNumber);
	// Enhanced wave start announcement with polished effects
	var waveAnnouncement = new Text2("WAVE " + waveNumber + " INCOMING!", {
		size: 72,
		fill: 0xFF4400
	});
	waveAnnouncement.anchor.set(0.5, 0.5);
	waveAnnouncement.x = 2048 / 2;
	waveAnnouncement.y = 2732 / 2;
	waveAnnouncement.alpha = 0;
	waveAnnouncement.scaleX = 0.3;
	waveAnnouncement.scaleY = 0.3;
	game.addChild(waveAnnouncement);
	// Dramatic announcement animation
	tween(waveAnnouncement, {
		alpha: 1,
		scaleX: 1.2,
		scaleY: 1.2,
		y: 2732 / 2 - 50
	}, {
		duration: 600,
		easing: tween.elasticOut,
		onFinish: function onFinish() {
			// Pulse effect
			tween(waveAnnouncement, {
				scaleX: 1.0,
				scaleY: 1.0,
				tint: 0xFFFFFF
			}, {
				duration: 300,
				onFinish: function onFinish() {
					// Fade out with explosion effect
					var explosionRing = LK.getAsset('rangeIndicator', {
						anchorX: 0.5,
						anchorY: 0.5,
						x: 2048 / 2,
						y: 2732 / 2 - 50,
						alpha: 0.6,
						tint: 0xFF6600,
						width: 100,
						height: 100
					});
					game.addChild(explosionRing);
					tween(explosionRing, {
						alpha: 0,
						width: 400,
						height: 400
					}, {
						duration: 800,
						easing: tween.easeOut,
						onFinish: function onFinish() {
							explosionRing.destroy();
						}
					});
					tween(waveAnnouncement, {
						alpha: 0,
						y: 2732 / 2 - 150
					}, {
						duration: 500,
						onFinish: function onFinish() {
							waveAnnouncement.destroy();
						}
					});
				}
			});
		}
	});
	// Screen flash for impact
	LK.effects.flashScreen(0xFF4400, 400);
	// Level-based enemy count and properties
	var enemyCount = 10;
	if (currentLevel === 2) {
		enemyCount = 7; // Reduced from 15 to 7 (about half)
	} else if (currentLevel === 3) {
		enemyCount = 20;
	}
	var enemyHealth = 80 + waveNumber * 20;
	var enemySpeed = 1 + waveNumber * 0.1;
	var reward = 10 + Math.floor(waveNumber / 2);
	waveInProgress = true;
	// Determine if we should spawn fast enemies (starting at wave 3)
	var spawnFastEnemies = waveNumber >= 3;
	var fastEnemyRatio = Math.min(0.3 + (waveNumber - 3) * 0.1, 0.6); // Increase ratio of fast enemies with wave number
	// Determine if we should spawn big enemies (starting at wave 2)
	var spawnBigEnemies = waveNumber >= 2;
	var bigEnemyRatio = Math.min(0.2 + (waveNumber - 2) * 0.08, 0.4); // Increase ratio of big enemies with wave number
	// Determine if we should spawn cloud enemies (starting at wave 1, but increase chance over time)
	var spawnCloudEnemies = waveNumber >= 1;
	var cloudEnemyRatio = Math.min(0.1 + (waveNumber - 1) * 0.05, 0.25); // 10-25% chance for cloud enemies
	// Find entry points for the two paths
	var entryPoints = [];
	// We know the first path starts at index 0 in gamePath
	entryPoints.push(0);
	// Find the second entry point - look for the second path starting point
	for (var i = 0; i < pathCoords.length; i++) {
		if (pathCoords[i].x === 6 && pathCoords[i].y === 13) {
			// Find the corresponding gamePath index for this coordinate
			for (var j = 0; j < gamePath.length; j++) {
				var dx = Math.abs(gamePath[j].x - getTileAt(6, 13).x);
				var dy = Math.abs(gamePath[j].y - getTileAt(6, 13).y);
				if (dx < 5 && dy < 5) {
					entryPoints.push(j);
					break;
				}
			}
			break;
		}
	}
	// Add warning about multiple entry points in early waves
	if (waveNumber === 1) {
		var multiPathWarning = new Text2("Warning: Multiple enemy entry points detected!", {
			size: 48,
			fill: 0xFF6600
		});
		multiPathWarning.anchor.set(0.5, 0.5);
		multiPathWarning.x = 2048 / 2;
		multiPathWarning.y = 400;
		game.addChild(multiPathWarning);
		// Flash warning and fade out
		tween(multiPathWarning, {
			alpha: 0
		}, {
			duration: 3000,
			onFinish: function onFinish() {
				multiPathWarning.destroy();
			}
		});
	}
	// Add warning about big enemies in wave 2
	if (waveNumber === 2) {
		var bigEnemyWarning = new Text2("Warning: Large enemies with erratic movement detected!", {
			size: 48,
			fill: 0xFF3300
		});
		bigEnemyWarning.anchor.set(0.5, 0.5);
		bigEnemyWarning.x = 2048 / 2;
		bigEnemyWarning.y = 400;
		game.addChild(bigEnemyWarning);
		// Flash warning and fade out
		tween(bigEnemyWarning, {
			alpha: 0
		}, {
			duration: 3000,
			onFinish: function onFinish() {
				bigEnemyWarning.destroy();
			}
		});
	}
	// Spawn enemies over time from both entry points
	var spawned = 0;
	if (waveNumber === 1) {
		// Only spawn one BigEnemy in the first wave
		var enemy = new BigEnemy(reward + 15);
		// Use the first entry point
		var startPoint = entryPoints[0];
		enemy.x = gamePath[startPoint].x;
		enemy.y = gamePath[startPoint].y;
		enemy.pathIndex = startPoint;
		game.addChild(enemy);
		enemies.push(enemy);
		// Immediately check for wave completion after a short delay
		LK.setTimeout(function () {
			checkWaveComplete();
		}, 1000);
	} else {
		var spawnInterval = LK.setInterval(function () {
			if (spawned < enemyCount) {
				var enemy;
				// Determine which type of enemy to spawn based on probabilities
				var enemyTypeRoll = Math.random();
				var isFastEnemy = spawnFastEnemies && enemyTypeRoll < fastEnemyRatio;
				var isBigEnemy = spawnBigEnemies && enemyTypeRoll >= fastEnemyRatio && enemyTypeRoll < fastEnemyRatio + bigEnemyRatio;
				var isCloudEnemy = spawnCloudEnemies && enemyTypeRoll >= fastEnemyRatio + bigEnemyRatio && enemyTypeRoll < fastEnemyRatio + bigEnemyRatio + cloudEnemyRatio;
				if (isFastEnemy) {
					enemy = new FastEnemy(reward + 5); // Better reward for fast enemies
					// Add a message when first fast enemy appears
					if (waveNumber === 3 && spawned === 0) {
						var warningText = new Text2("Warning: Fast enemies spotted!", {
							size: 48,
							fill: 0x00FFFF
						});
						warningText.anchor.set(0.5, 0.5);
						warningText.x = 2048 / 2;
						warningText.y = 300;
						game.addChild(warningText);
						// Flash warning and fade out
						tween(warningText, {
							alpha: 0
						}, {
							duration: 3000,
							onFinish: function onFinish() {
								warningText.destroy();
							}
						});
					}
				} else if (isBigEnemy) {
					enemy = new BigEnemy(reward + 15); // Much better reward for big enemies
				} else if (isCloudEnemy) {
					enemy = new CloudEnemy(reward + 20); // Best reward for cloud enemies
					// Add a message when first cloud enemy appears
					if (waveNumber === 1 && spawned === 0) {
						var cloudWarningText = new Text2("Warning: Hostile cloud detected!", {
							size: 48,
							fill: 0x330000
						});
						cloudWarningText.anchor.set(0.5, 0.5);
						cloudWarningText.x = 2048 / 2;
						cloudWarningText.y = 350;
						game.addChild(cloudWarningText);
						// Flash warning and fade out
						tween(cloudWarningText, {
							alpha: 0
						}, {
							duration: 3000,
							onFinish: function onFinish() {
								cloudWarningText.destroy();
							}
						});
					}
				} else {
					enemy = new Enemy(enemyHealth, enemySpeed, reward);
				}
				// After wave 3, spawn enemies only from the closest path to the base
				var startPoint;
				if (waveNumber > 3) {
					// Choose the entry point closest to the base
					startPoint = entryPoints[entryPoints.length - 1];
				} else {
					// Alternate between entry points or randomize
					var entryPointIndex = spawned % entryPoints.length;
					startPoint = entryPoints[entryPointIndex];
				}
				// Start at the chosen entry point
				enemy.x = gamePath[startPoint].x;
				enemy.y = gamePath[startPoint].y;
				enemy.pathIndex = startPoint; // Set the correct path index
				game.addChild(enemy);
				enemies.push(enemy);
				spawned++;
			} else {
				LK.clearInterval(spawnInterval);
				// Set timer to check when wave is complete
				checkWaveComplete();
			}
		}, 800);
	}
	// Disable next wave button
	nextWaveButton.setEnabled(false);
}
function checkWaveComplete() {
	nextWaveTimeout = LK.setInterval(function () {
		var activeEnemies = 0;
		for (var i = 0; i < enemies.length; i++) {
			if (!enemies[i].isDead) {
				activeEnemies++;
			}
		}
		if (activeEnemies === 0) {
			waveInProgress = false;
			nextWaveButton.setEnabled(true);
			// Advance the storyline
			storyline.nextPart();
			// Bonus gold for completing a wave
			var bonus = 30 + waveNumber * 5;
			gold += bonus;
			goldText.setText("Gold: " + gold);
			// Update build button state
			buildTowerButton.setEnabled(gold >= 50);
			LK.clearInterval(nextWaveTimeout);
			// Always advance to next level after each wave, up to 10 levels
			if (playerLives > 0) {
				if (currentLevel < 10) {
					currentLevel++;
					waveNumber = 0;
					waveText.setText("Level: " + currentLevel + " Wave: " + waveNumber);
					// Show secret code when reaching level 3
					if (currentLevel === 3) {
						// Create dramatic secret code reveal - bigger and longer lasting
						var secretCodeContainer = new Container();
						secretCodeContainer.x = 2048 / 2;
						secretCodeContainer.y = 2732 / 2;
						secretCodeContainer.alpha = 0;
						game.addChild(secretCodeContainer);
						// Background for the secret code - much larger
						var secretBackground = LK.getAsset('healthBarBg', {
							anchorX: 0.5,
							anchorY: 0.5,
							alpha: 0.95,
							width: 1200,
							height: 600,
							color: 0x000000
						});
						secretCodeContainer.addChild(secretBackground);
						// "SECRET CODE UNLOCKED" text - bigger
						var secretTitle = new Text2("SECRET CODE UNLOCKED!", {
							size: 72,
							fill: 0x00FF00
						});
						secretTitle.anchor.set(0.5, 0.5);
						secretTitle.y = -120;
						secretCodeContainer.addChild(secretTitle);
						// The actual secret code - much bigger
						var secretCodeText = new Text2("ali3n", {
							size: 150,
							fill: 0x00FFFF
						});
						secretCodeText.anchor.set(0.5, 0.5);
						secretCodeText.y = 0;
						secretCodeContainer.addChild(secretCodeText);
						// Instructions - bigger
						var instructionText = new Text2("Remember this code!", {
							size: 54,
							fill: 0xFFFFFF
						});
						instructionText.anchor.set(0.5, 0.5);
						instructionText.y = 120;
						secretCodeContainer.addChild(instructionText);
						// Dramatic entrance animation
						tween(secretCodeContainer, {
							alpha: 1,
							scaleX: 1.1,
							scaleY: 1.1
						}, {
							duration: 1000,
							easing: tween.elasticOut,
							onFinish: function onFinish() {
								// Continuous glowing effect on the secret code for the full minute
								var _continuousGlow = function continuousGlow() {
									tween(secretCodeText, {
										tint: 0xFFFF00
									}, {
										duration: 1000,
										easing: tween.easeInOut,
										onFinish: function onFinish() {
											tween(secretCodeText, {
												tint: 0x00FFFF
											}, {
												duration: 1000,
												easing: tween.easeInOut,
												onFinish: _continuousGlow
											});
										}
									});
								};
								_continuousGlow();
								// Stay visible for a full minute (60 seconds)
								LK.setTimeout(function () {
									tween(secretCodeContainer, {
										alpha: 0,
										scaleX: 0.8,
										scaleY: 0.8
									}, {
										duration: 2000,
										onFinish: function onFinish() {
											game.removeChild(secretCodeContainer);
										}
									});
								}, 60000); // 60 seconds = 1 minute
							}
						});
						// Add particle effects around the secret code
						for (var i = 0; i < 12; i++) {
							(function (index) {
								var angle = Math.PI * 2 * index / 12;
								var particle = LK.getAsset('fire', {
									anchorX: 0.5,
									anchorY: 0.5,
									x: Math.cos(angle) * 200,
									y: Math.sin(angle) * 150,
									alpha: 0,
									tint: 0x00FF88,
									scaleX: 0.2,
									scaleY: 0.2
								});
								secretCodeContainer.addChild(particle);
								LK.setTimeout(function () {
									tween(particle, {
										alpha: 0.8,
										scaleX: 0.5,
										scaleY: 0.5
									}, {
										duration: 600,
										easing: tween.easeOut
									});
									// Orbital motion
									var _orbitParticle2 = function orbitParticle() {
										var newAngle = angle + Math.PI * 2;
										tween(particle, {
											x: Math.cos(newAngle) * 200,
											y: Math.sin(newAngle) * 150
										}, {
											duration: 3000,
											easing: tween.linear,
											onFinish: function onFinish() {
												angle = newAngle;
												_orbitParticle2();
											}
										});
									};
									_orbitParticle2();
								}, index * 100);
							})(i);
						}
						// Screen flash effect
						LK.effects.flashScreen(0x00FF88, 1000);
					}
					initGame();
					// Auto-start the first wave of the new level after a delay
					LK.setTimeout(function () {
						startNextWave();
					}, 2000); // 2 second delay to let level transition effects show
				} else {
					LK.showYouWin();
				}
			}
		}
	}, 1000);
}
function selectTower(tower) {
	// Deselect current tower if any
	if (selectedTower && selectedTower !== tower) {
		selectedTower.deselect();
	}
	// Select new tower
	selectedTower = tower;
	tower.select();
	showTowerUI(tower);
	upgradeButton.setText('Upgrade (' + tower.getUpgradeCost() + 'g)');
	sellButton.setText('Sell (' + tower.sellValue() + 'g)');
	upgradeButton.setEnabled(gold >= tower.getUpgradeCost());
	// Cancel tower placement if active
	if (isPlacingTower) {
		isPlacingTower = false;
		if (placingTowerIndicator) {
			game.removeChild(placingTowerIndicator);
			placingTowerIndicator = null;
		}
	}
}
function showTowerUI(tower) {
	towerUI.visible = true;
	towerUI.x = tower.x + 100;
	towerUI.y = tower.y - 50;
	upgradeButton.setText('Upgrade (' + tower.getUpgradeCost() + 'g)');
	sellButton.setText('Sell (' + tower.sellValue() + 'g)');
	// Check if player has enough gold for upgrade
	upgradeButton.setEnabled(gold >= tower.getUpgradeCost());
}
function hideTowerUI() {
	towerUI.visible = false;
}
// Mouse events
game.down = function (x, y, obj) {
	// --- Secret Easter Egg: Upper Left Corner Click ---
	// Only trigger if click is in the upper left 100x100 px (avoid platform menu, but allow for secret)
	if (x >= 0 && x <= 100 && y >= 0 && y <= 100) {
		// Show the egg1 image as easter egg
		var eggImage = LK.getAsset('egg1', {
			anchorX: 0.5,
			anchorY: 0.5,
			x: 60,
			y: 60,
			alpha: 0,
			scaleX: 0.3,
			scaleY: 0.3
		});
		game.addChild(eggImage);
		// Animate the egg appearing
		tween(eggImage, {
			alpha: 1,
			scaleX: 1.0,
			scaleY: 1.0
		}, {
			duration: 500,
			easing: tween.elasticOut,
			onFinish: function onFinish() {
				// Keep egg visible for 2 seconds, then fade out
				LK.setTimeout(function () {
					tween(eggImage, {
						alpha: 0,
						scaleX: 0.1,
						scaleY: 0.1
					}, {
						duration: 700,
						onFinish: function onFinish() {
							eggImage.destroy();
						}
					});
				}, 2000);
			}
		});
		// Do not process other clicks if easter egg is triggered
		return;
	}
	// --- Diagnostic Sound Test ---
	// Try playing a sound on the first interaction
	LK.getSound('towerPlace').play();
	console.log("Attempted to play 'towerPlace' sound on down event.");
	// --- End Diagnostic ---
	if (isPlacingTower) {
		var gridPos = getGridCoordinates(x, y);
		if (gridPos && gridPos.tile.canPlaceTower()) {
			// Use the selected tower index when placing
			if (placeTower(gridPos.tile, selectedTowerIndex)) {
				isPlacingTower = false;
				game.removeChild(placingTowerIndicator);
				placingTowerIndicator = null;
			}
		}
	} else {
		// --- NPC1 Mining Selection Logic ---
		var npc = getNPC1At(x, y);
		if (npc) {
			// Select this NPC1
			deselectNPC();
			selectedNPC = npc;
			showNPCSelectionRing(npc);
			return; // Don't select towers if NPC1 was selected
		}
		// If an NPC1 is already selected, clicking anywhere else sets mining target
		if (selectedNPC) {
			// Set mining target to clicked position
			npcMiningTarget = {
				x: x,
				y: y
			};
			npcMiningActive = true;
			npcMiningProgress = 0;
			// Remove selection ring (will reappear at mining site)
			if (selectedNPC.selectionRing) {
				selectedNPC.removeChild(selectedNPC.selectionRing);
				selectedNPC.selectionRing = null;
			}
			return;
		}
		// Check if clicked on a tower
		var towerClicked = false;
		for (var i = 0; i < towers.length; i++) {
			var dx = Math.abs(towers[i].x - x);
			var dy = Math.abs(towers[i].y - y);
			if (dx < 75 && dy < 75) {
				selectTower(towers[i]);
				towerClicked = true;
				break;
			}
		}
		// If clicked elsewhere, deselect tower
		if (!towerClicked && selectedTower) {
			selectedTower.deselect();
			selectedTower = null;
			hideTowerUI();
		}
		// Deselect NPC if clicking elsewhere and not mining
		if (!npcMiningActive) {
			deselectNPC();
		}
	}
};
game.move = function (x, y, obj) {
	if (isPlacingTower && placingTowerIndicator) {
		var gridPos = getGridCoordinates(x, y);
		if (gridPos) {
			placingTowerIndicator.x = gridPos.tile.x;
			placingTowerIndicator.y = gridPos.tile.y;
			// Change color based on whether placement is valid
			placingTowerIndicator.tint = gridPos.tile.canPlaceTower() ? 0x00ff00 : 0xff0000;
		}
	}
};
// Update all enemies
game.update = function () {
	// Update all enemies
	for (var i = enemies.length - 1; i >= 0; i--) {
		var enemy = enemies[i];
		if (enemy && enemy.isDead) {
			enemies.splice(i, 1);
		} else if (enemy) {
			enemy.update();
		}
	}
	// Update all towers
	for (var i = 0; i < towers.length; i++) {
		var tower = towers[i];
		// Check if it's time to fire
		if (LK.ticks - tower.lastFireTime > tower.fireRate / (1000 / 60)) {
			if (tower.findTarget(enemies)) {
				tower.shoot();
				tower.lastFireTime = LK.ticks;
			}
		}
	}
	// Fog of war removed
	// Update all bullets
	for (var i = bullets.length - 1; i >= 0; i--) {
		bullets[i].update();
		if (!bullets[i].parent) {
			bullets.splice(i, 1);
		}
	}
	// Update thunderstorm effect
	if (window.thunderStorm) {
		window.thunderStorm.update();
	}
	// --- NPC1 Mining Update Logic ---
	if (selectedNPC && npcMiningActive && npcMiningTarget) {
		// Move NPC1 toward mining target
		var dx = npcMiningTarget.x - selectedNPC.x;
		var dy = npcMiningTarget.y - selectedNPC.y;
		var dist = Math.sqrt(dx * dx + dy * dy);
		var moveSpeed = 6; // Move speed for mining
		if (dist > 10) {
			// Move toward target
			selectedNPC.x += dx / dist * moveSpeed;
			selectedNPC.y += dy / dist * moveSpeed;
			// Show mining ring at target
			if (!selectedNPC.miningRing) {
				var ring = LK.getAsset('rangeIndicator', {
					anchorX: 0.5,
					anchorY: 0.5,
					x: 0,
					y: 0,
					alpha: 0.4,
					tint: 0x708090,
					width: 80,
					height: 80
				});
				ring.x = npcMiningTarget.x - selectedNPC.x;
				ring.y = npcMiningTarget.y - selectedNPC.y;
				selectedNPC.addChild(ring);
				selectedNPC.miningRing = ring;
				// Animate ring
				tween(ring, {
					alpha: 0.1,
					width: 120,
					height: 120
				}, {
					duration: 700,
					yoyo: true,
					repeat: Infinity
				});
			}
		} else {
			// At mining site, start mining
			npcMiningProgress++;
			// Show mining animation (pulse ring)
			if (selectedNPC.miningRing) {
				selectedNPC.miningRing.alpha = 0.5 + 0.3 * Math.sin(npcMiningProgress / 5);
			}
			// Mining complete
			if (npcMiningProgress >= npcMiningDuration) {
				// Add stone to resources
				resources.stone += npcMiningStonePerCycle;
				stoneText.setText("Stone: " + resources.stone);
				showMiningText(selectedNPC.x, selectedNPC.y, npcMiningStonePerCycle);
				// Reset mining
				npcMiningActive = false;
				npcMiningProgress = 0;
				npcMiningTarget = null;
				// Remove mining ring
				if (selectedNPC.miningRing) {
					selectedNPC.removeChild(selectedNPC.miningRing);
					selectedNPC.miningRing = null;
				}
				// Keep NPC selected for repeated mining
			}
		}
	} else {
		// Remove mining ring if not mining
		if (selectedNPC && selectedNPC.miningRing) {
			selectedNPC.removeChild(selectedNPC.miningRing);
			selectedNPC.miningRing = null;
		}
	}
	// Fog of war removed
	// Update button states based on gold
	if (buildTowerButton) {
		buildTowerButton.setEnabled(gold >= 50 && !isPlacingTower);
	}
	if (selectedTower) {
		upgradeButton.setEnabled(gold >= selectedTower.getUpgradeCost());
	}
};
// Initialize game
function initGame() {
	// Apply zoom effect by scaling the game container
	game.scale.x = 1.2; // Zoom in by 20%
	game.scale.y = 1.2; // Zoom in by 20%
	// Center the zoomed content
	game.x = (2048 - 2048 * 1.2) / 2;
	game.y = (2732 - 2732 * 1.2) / 2;
	// Create thunderstorm effect
	if (window.thunderStorm) {
		game.removeChild(window.thunderStorm);
	}
	window.thunderStorm = new ThunderStorm();
	game.addChild(window.thunderStorm);
	// Reset game state
	gold = 200 + (currentLevel - 1) * 50; // Increase starting gold with each level
	playerLives = 10 + (currentLevel - 1) * 5; // Increase starting lives with each level
	waveNumber = 0;
	LK.setScore(0);
	// Reset arrays
	enemies = [];
	towers = [];
	bullets = [];
	// Update UI
	goldText.setText("Gold: " + gold);
	woodText.setText("Wood: " + resources.wood);
	stoneText.setText("Stone: " + resources.stone);
	livesText.setText("Lives: " + playerLives);
	waveText.setText("Level: " + currentLevel + " Wave: " + waveNumber);
	scoreText.setText("Score: 0");
	// Initialize build tower button
	if (!buildTowerButton) {
		buildTowerButton = new Button('Build\nTower', 180, 100, 0x44cc44, 'basicTurretButton');
		// Position the button to appear next to the upgrade button at the top of the screen
		LK.gui.top.addChild(buildTowerButton);
		buildTowerButton.x = 250; // Position to the right of upgrade button
		buildTowerButton.y = 30; // Same y-level as the upgrade button
		buildTowerButton.onClick = function () {
			if (gold >= 50 && !isPlacingTower) {
				isPlacingTower = true;
				selectedTowerIndex = 0; // Default to basic tower
				// Create tower placement indicator
				placingTowerIndicator = LK.getAsset('tower', {
					anchorX: 0.5,
					anchorY: 1.0,
					alpha: 0.5
				});
				game.addChild(placingTowerIndicator);
				// Deselect any selected tower
				if (selectedTower) {
					selectedTower.deselect();
					selectedTower = null;
				}
			}
		};
	}
	// Fog of war removed
	// Move upgrade button to sidebar menu
	var sidebarUpgradeButton = new Button('Upgrade\nTower', 400, 100, 0x44cc44, 'basicTurretButton');
	sidebarContainer.addChild(sidebarUpgradeButton);
	sidebarUpgradeButton.x = 25;
	sidebarUpgradeButton.y = 620; // Position in sidebar below other buttons
	sidebarUpgradeButton.onClick = function () {
		if (selectedTower && gold >= selectedTower.getUpgradeCost()) {
			selectedTower.upgrade();
			// Update UI text
			upgradeButton.setText('Upgrade (' + selectedTower.getUpgradeCost() + 'g)');
			sellButton.setText('Sell (' + selectedTower.sellValue() + 'g)');
			// Check if player has enough gold for next upgrade
			upgradeButton.setEnabled(gold >= selectedTower.getUpgradeCost());
		}
	};
	// Create epic company intro sequence
	var introContainer = new Container();
	introContainer.x = 2048 / 2;
	introContainer.y = 2732 / 2;
	introContainer.alpha = 0;
	game.addChild(introContainer);
	// Black background for cinematic intro
	var introBackground = LK.getAsset('healthBarBg', {
		anchorX: 0.5,
		anchorY: 0.5,
		width: 2048,
		height: 2732,
		alpha: 0.95,
		color: 0x000000
	});
	introContainer.addChild(introBackground);
	// Stage 1: "A Game by" text
	var byText = new Text2("A Game by", {
		size: 60,
		fill: 0xCCCCCC
	});
	byText.anchor.set(0.5, 0.5);
	byText.y = -150;
	byText.alpha = 0;
	introContainer.addChild(byText);
	// Stage 2: "ordinary" company name
	var ordinaryText = new Text2("ordinary", {
		size: 120,
		fill: 0xFFFFFF
	});
	ordinaryText.anchor.set(0.5, 0.5);
	ordinaryText.y = -250;
	ordinaryText.alpha = 0;
	ordinaryText.scaleX = 0.3;
	ordinaryText.scaleY = 0.3;
	introContainer.addChild(ordinaryText);
	// Stage 3: "& upit" text
	var upitText = new Text2("& upit", {
		size: 100,
		fill: 0xFF6600
	});
	upitText.anchor.set(0.5, 0.5);
	upitText.y = -120;
	upitText.alpha = 0;
	upitText.scaleX = 0.3;
	upitText.scaleY = 0.3;
	introContainer.addChild(upitText);
	// Stage 4: Game title removed
	// Create particle systems for each company
	function createCompanyParticles(centerX, centerY, color, count) {
		for (var i = 0; i < count; i++) {
			(function (index) {
				var particle = LK.getAsset('fire', {
					anchorX: 0.5,
					anchorY: 0.5,
					x: centerX,
					y: centerY,
					alpha: 0,
					tint: color,
					scaleX: 0.1,
					scaleY: 0.1
				});
				introContainer.addChild(particle);
				LK.setTimeout(function () {
					var angle = Math.PI * 2 * index / count;
					var distance = 80 + Math.random() * 40;
					tween(particle, {
						alpha: 0.8,
						x: centerX + Math.cos(angle) * distance,
						y: centerY + Math.sin(angle) * distance,
						scaleX: 0.4,
						scaleY: 0.4
					}, {
						duration: 800,
						easing: tween.easeOut,
						onFinish: function onFinish() {
							tween(particle, {
								alpha: 0,
								scaleX: 0.1,
								scaleY: 0.1
							}, {
								duration: 600,
								onFinish: function onFinish() {
									introContainer.removeChild(particle);
								}
							});
						}
					});
				}, index * 100);
			})(i);
		}
	}
	// Epic intro sequence
	tween(introContainer, {
		alpha: 1
	}, {
		duration: 800,
		onFinish: function onFinish() {
			// Show "A Game by" text
			tween(byText, {
				alpha: 1,
				y: -300
			}, {
				duration: 1000,
				easing: tween.easeOut,
				onFinish: function onFinish() {
					// Show "ordinary" with dramatic effect
					LK.setTimeout(function () {
						tween(ordinaryText, {
							alpha: 1,
							scaleX: 1.2,
							scaleY: 1.2,
							y: -400
						}, {
							duration: 1200,
							easing: tween.elasticOut,
							onFinish: function onFinish() {
								// Create particles for ordinary
								createCompanyParticles(0, -400, 0x00FFFF, 8);
								// Glow effect for ordinary
								var ordinaryGlow = LK.getAsset('rangeIndicator', {
									anchorX: 0.5,
									anchorY: 0.5,
									x: 0,
									y: -400,
									alpha: 0,
									tint: 0x00FFFF,
									width: 400,
									height: 150
								});
								introContainer.addChild(ordinaryGlow);
								tween(ordinaryGlow, {
									alpha: 0.3
								}, {
									duration: 500,
									onFinish: function onFinish() {
										tween(ordinaryGlow, {
											alpha: 0
										}, {
											duration: 800,
											onFinish: function onFinish() {
												introContainer.removeChild(ordinaryGlow);
											}
										});
									}
								});
								// Show "& upit" after delay
								LK.setTimeout(function () {
									tween(upitText, {
										alpha: 1,
										scaleX: 1.1,
										scaleY: 1.1,
										y: -270
									}, {
										duration: 1000,
										easing: tween.elasticOut,
										onFinish: function onFinish() {
											// Create particles for upit
											createCompanyParticles(0, -270, 0xFF6600, 6);
											// Screen flash effect without title
											LK.effects.flashScreen(0xFF6600, 600);
											// Final explosion of particles
											for (var i = 0; i < 20; i++) {
												(function (index) {
													var finalParticle = LK.getAsset('fire', {
														anchorX: 0.5,
														anchorY: 0.5,
														x: 0,
														y: 0,
														alpha: 0.9,
														tint: [0x00FFFF, 0xFF6600, 0xFFFF00][index % 3],
														scaleX: 0.3,
														scaleY: 0.3
													});
													introContainer.addChild(finalParticle);
													var angle = Math.PI * 2 * index / 20;
													var distance = 150 + Math.random() * 100;
													tween(finalParticle, {
														x: Math.cos(angle) * distance,
														y: 0 + Math.sin(angle) * distance,
														alpha: 0,
														scaleX: 0.05,
														scaleY: 0.05
													}, {
														duration: 1200,
														easing: tween.easeOut,
														onFinish: function onFinish() {
															introContainer.removeChild(finalParticle);
														}
													});
												})(i);
											}
											// Fade out intro after displaying
											LK.setTimeout(function () {
												tween(introContainer, {
													alpha: 0,
													scaleX: 1.3,
													scaleY: 1.3
												}, {
													duration: 2000,
													easing: tween.easeIn,
													onFinish: function onFinish() {
														game.removeChild(introContainer);
														// Now start the actual game intro
														startGameIntro();
													}
												});
											}, 1500);
										}
									});
								}, 800);
							}
						});
					}, 500);
				}
			});
		}
	});
	// Function to start the actual game intro after company credits
	function startGameIntro() {
		// Initialize and display the storyline with enhanced polished intro effects
		storyline = new Storyline();
		storyline.x = 2048 / 2;
		storyline.y = 2732 / 4;
		storyline.alpha = 0; // Start invisible for fade-in effect
		storyline.scaleX = 0.3; // Start small for dramatic entrance
		storyline.scaleY = 0.3;
		game.addChild(storyline);
		// Create dramatic intro sequence with multiple visual effects
		// Stage 1: Fade in the game world with zoom effect
		game.alpha = 0;
		game.scaleX = 0.8;
		game.scaleY = 0.8;
		tween(game, {
			alpha: 1,
			scaleX: 1.2,
			scaleY: 1.2
		}, {
			duration: 1500,
			easing: tween.easeOut,
			onFinish: function onFinish() {
				// Stage 2: Dramatic storyline entrance
				tween(storyline, {
					alpha: 1,
					y: 2732 / 3,
					scaleX: 1.0,
					scaleY: 1.0
				}, {
					duration: 1200,
					easing: tween.elasticOut,
					onFinish: function onFinish() {
						// Stage 3: Add glowing border effect to storyline
						var glowEffect = LK.getAsset('rangeIndicator', {
							anchorX: 0.5,
							anchorY: 0.5,
							x: 0,
							y: 0,
							alpha: 0,
							tint: 0x00FFFF,
							width: 1650,
							height: 350
						});
						storyline.addChild(glowEffect);
						// Pulsing glow effect
						var _pulseGlow = function pulseGlow() {
							tween(glowEffect, {
								alpha: 0.3,
								scaleX: 1.05,
								scaleY: 1.05
							}, {
								duration: 1000,
								easing: tween.easeInOut,
								onFinish: function onFinish() {
									tween(glowEffect, {
										alpha: 0.1,
										scaleX: 1.0,
										scaleY: 1.0
									}, {
										duration: 1000,
										easing: tween.easeInOut,
										onFinish: _pulseGlow
									});
								}
							});
						};
						_pulseGlow();
						// Stage 4: Add floating particles around storyline
						for (var i = 0; i < 8; i++) {
							(function (index) {
								var angle = Math.PI * 2 * index / 8;
								var particle = LK.getAsset('fire', {
									anchorX: 0.5,
									anchorY: 0.5,
									x: Math.cos(angle) * 150,
									y: Math.sin(angle) * 100,
									alpha: 0,
									tint: 0x88AAFF,
									scaleX: 0.3,
									scaleY: 0.3
								});
								storyline.addChild(particle);
								// Delayed particle appearance
								LK.setTimeout(function () {
									tween(particle, {
										alpha: 0.7,
										scaleX: 0.5,
										scaleY: 0.5
									}, {
										duration: 800,
										easing: tween.easeOut
									});
									// Continuous orbital motion
									var _orbitParticle = function orbitParticle() {
										var newAngle = angle + Math.PI * 2;
										tween(particle, {
											x: Math.cos(newAngle) * 150,
											y: Math.sin(newAngle) * 100
										}, {
											duration: 4000,
											easing: tween.linear,
											onFinish: function onFinish() {
												angle = newAngle;
												_orbitParticle();
											}
										});
									};
									_orbitParticle();
								}, index * 200);
							})(i);
						}
						// Stage 5: Screen flash effect for dramatic impact
						LK.effects.flashScreen(0x0088FF, 800);
						// Stage 6: Start background music with enhanced fade-in
						LK.playMusic('bgmusic', {
							loop: true,
							fade: {
								start: 0,
								end: 1,
								duration: 3000
							}
						});
						// Stage 7: Add cinematic text zoom effect on storyline text changes
						var originalNextPart = storyline.nextPart;
						storyline.nextPart = function () {
							// Create zoom-in effect when text changes
							tween(storyline, {
								scaleX: 1.1,
								scaleY: 1.1
							}, {
								duration: 300,
								easing: tween.easeOut,
								onFinish: function onFinish() {
									originalNextPart.call(storyline);
									tween(storyline, {
										scaleX: 1.0,
										scaleY: 1.0
									}, {
										duration: 400,
										easing: tween.easeIn
									});
								}
							});
							// Add text transition particle burst
							for (var i = 0; i < 6; i++) {
								var burstParticle = LK.getAsset('fire', {
									anchorX: 0.5,
									anchorY: 0.5,
									x: 0,
									y: 0,
									alpha: 0.8,
									tint: 0xFFFF88,
									scaleX: 0.2,
									scaleY: 0.2
								});
								storyline.addChild(burstParticle);
								var burstAngle = Math.PI * 2 * i / 6;
								var distance = 100 + Math.random() * 50;
								tween(burstParticle, {
									x: Math.cos(burstAngle) * distance,
									y: Math.sin(burstAngle) * distance,
									alpha: 0,
									scaleX: 0.05,
									scaleY: 0.05
								}, {
									duration: 600,
									easing: tween.easeOut,
									onFinish: function onFinish() {
										storyline.removeChild(burstParticle);
									}
								});
							}
						};
					}
				});
			}
		});
	}
	// Create map
	// --- Multi-world support ---
	// List of available world map files (world1.js, world2.js, etc.)
	// Each world file should define a function createMap_<name>() that returns {tileMap, pathCoords, gamePath, basePosition}
	var availableWorlds = [{
		name: "Default",
		loader: function loader() {
			createMap();
		}
	}];
	// If additional world.js files are present, push them here, e.g.:
	// availableWorlds.push({ name: "Desert", loader: function() { createMap_desert(); } });
	// availableWorlds.push({ name: "Ice", loader: function() { createMap_ice(); } });
	var currentWorldIndex = 0;
	// Add a world switcher button to the sidebar menu beside EM turret button
	var worldSwitchButton = new Button('Select\nWorld', 400, 100, 0x8888ff, 'basicTurretButton');
	worldSwitchButton.x = 25;
	worldSwitchButton.y = 720; // Position in sidebar below upgrade button
	sidebarContainer.addChild(worldSwitchButton);
	worldSwitchButton.onClick = function () {
		// Cycle to next world
		currentWorldIndex = (currentWorldIndex + 1) % availableWorlds.length;
		// Re-initialize the game with the new world
		if (availableWorlds[currentWorldIndex] && availableWorlds[currentWorldIndex].loader) {
			availableWorlds[currentWorldIndex].loader();
			// Optionally, show a message
			var msg = new Text2("World: " + availableWorlds[currentWorldIndex].name, {
				size: 48,
				fill: 0x8888ff
			});
			msg.anchor.set(0.5, 0.5);
			msg.x = 2048 / 2;
			msg.y = 200;
			game.addChild(msg);
			tween(msg, {
				alpha: 0
			}, {
				duration: 2000,
				onFinish: function onFinish() {
					msg.destroy();
				}
			});
		}
	};
	// On game start, load the default world
	availableWorlds[currentWorldIndex].loader();
	// Music playlist system
	var musicPlaylist = ['bg2', 'bg3', 'bg4'];
	var currentMusicIndex = 0;
	var musicTransitionTimer = null;
	function playRandomMusic() {
		// Select random track from playlist
		var randomIndex = Math.floor(Math.random() * musicPlaylist.length);
		var selectedTrack = musicPlaylist[randomIndex];
		currentMusicIndex = randomIndex;
		// Play the selected track
		LK.playMusic(selectedTrack, {
			loop: false,
			fade: {
				start: 0,
				end: 0.6,
				duration: 1000
			}
		});
		// Set timer for next track (30 seconds)
		if (musicTransitionTimer) {
			LK.clearTimeout(musicTransitionTimer);
		}
		musicTransitionTimer = LK.setTimeout(function () {
			playRandomMusic(); // Play next random track
		}, 30000); // 30 seconds
	}
	// Enhanced intro music sequence with smooth transitions
	LK.playMusic('intro', {
		loop: false,
		fade: {
			start: 0,
			end: 0.8,
			duration: 1000
		}
	});
	// Create intro music visualization effects
	var musicVisualization = LK.getAsset('rangeIndicator', {
		anchorX: 0.5,
		anchorY: 0.5,
		x: 2048 / 2,
		y: 2732 - 100,
		alpha: 0.4,
		tint: 0xFF6600,
		width: 50,
		height: 50
	});
	game.addChild(musicVisualization);
	// Pulsing music visualization
	var _visualizePulse = function visualizePulse() {
		tween(musicVisualization, {
			alpha: 0.7,
			scaleX: 1.5,
			scaleY: 1.5,
			tint: 0x00FFFF
		}, {
			duration: 600,
			easing: tween.easeInOut,
			onFinish: function onFinish() {
				tween(musicVisualization, {
					alpha: 0.2,
					scaleX: 1.0,
					scaleY: 1.0,
					tint: 0xFF6600
				}, {
					duration: 800,
					easing: tween.easeInOut,
					onFinish: _visualizePulse
				});
			}
		});
	};
	_visualizePulse();
	var introMusicDuration = 20000; // Set to the actual intro music duration in ms (20 seconds)
	LK.setTimeout(function () {
		// Fade out intro music and visualization
		tween(musicVisualization, {
			alpha: 0,
			scaleX: 0.1,
			scaleY: 0.1
		}, {
			duration: 1500,
			onFinish: function onFinish() {
				game.removeChild(musicVisualization);
			}
		});
		// Start random playlist instead of single track
		playRandomMusic();
	}, introMusicDuration - 2000); // Start transition 2 seconds before intro ends
	// --- Diagnostic Sound Test ---
	// Try playing a sound immediately on game start
	LK.getSound('shoot').play();
	console.log("Attempted to play 'shoot' sound on init.");
	// --- End Diagnostic ---
}
// Game loop to manage state transitions
function gameLoop() {
	if (playerLives > 0) {
		if (!waveInProgress) {
			startNextWave();
		}
	} else {
		LK.showGameOver();
	}
}
// Start game loop
initGame();
LK.setInterval(gameLoop, 1000);