		var dy = self.targetEnemy.y - self.y;
		var angle = Math.atan2(dy, dx);
		// Remove tower rotation to prevent movement - keep towers stationary
		var bullet = new Bullet(self.x, self.y, self.targetEnemy, self.damage, self); // Pass the tower as the damage source
		game.addChild(bullet);
		bullets.push(bullet);
		getRandomShootSound().play();
		// Enhanced multi-stage muzzle flash
		var muzzleFlash1 = LK.getAsset('fire', {
			anchorX: 0.5,
			anchorY: 0.5,
			x: self.x + Math.cos(angle) * 30,
			y: self.y + Math.sin(angle) * 30,
			rotation: angle,
			alpha: 0.95,
			tint: 0xFFFFFF,
			// Bright white core
			scaleX: 0.8,
			scaleY: 0.8
		});
		game.addChild(muzzleFlash1);
		var muzzleFlash2 = LK.getAsset('fire', {
			anchorX: 0.5,
			anchorY: 0.5,
			x: self.x + Math.cos(angle) * 25,
			y: self.y + Math.sin(angle) * 25,
			rotation: angle,
			alpha: 0.7,
			tint: 0xFFFF00,
			// Yellow outer layer
			scaleX: 1.2,
			scaleY: 1.2
		});
		game.addChild(muzzleFlash2);
		// Multi-stage flash animation
		tween(muzzleFlash1, {
			alpha: 0,
			scaleX: 1.8,
			scaleY: 1.8
		}, {
			duration: 200,
			easing: tween.easeOut,
			onFinish: function onFinish() {
				muzzleFlash1.destroy();
			}
		});
		tween(muzzleFlash2, {
			alpha: 0,
			scaleX: 2.5,
			scaleY: 2.5,
			rotation: angle + Math.PI
		}, {
			duration: 350,
			easing: tween.easeOut,
			onFinish: function onFinish() {
				muzzleFlash2.destroy();
			}
		});
		// Enhanced targeting laser
		var targetingLaser = LK.getAsset('lightning', {
			anchorX: 0.5,
			anchorY: 0.0,
			x: self.x,
			y: self.y,
			rotation: angle,
			height: Math.sqrt(dx * dx + dy * dy),
			width: 3,
			alpha: 0.8,
			tint: 0xFF0000
		});
		game.addChild(targetingLaser);
		// Pulsing laser effect
		tween(targetingLaser, {
			alpha: 0,
			width: 1,
			tint: 0xFFFF88
		}, {
			duration: 250,
			easing: tween.easeInOut,
			onFinish: function onFinish() {
				targetingLaser.destroy();
			}
		});
		// Keep towers stationary - only flash effect without movement
		// Remove screen shake to keep turrets stable
		LK.effects.flashObject(towerGraphic, 0xffff00, 150);
		return true;
	};
	self.upgrade = function () {
		if (gold >= self.getUpgradeCost()) {
			// Show stat improvement numbers floating up
			var createFloatingNumber = function createFloatingNumber(value, color, offsetX) {
				var text = new Text2("+" + value, {
					size: 32,
					fill: color
				});
				text.anchor.set(0.5, 0.5);
