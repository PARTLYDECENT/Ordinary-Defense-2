			rotation: (Math.random() - 0.5) * 0.4 // Add rotational movement for more menacing effect
		}, {
			duration: 3000 + Math.random() * 4000,
			// Faster cycles
			yoyo: true,
			repeat: Infinity,
			easing: tween.easeInOut
		});
	}
	// Lightning creation function removed - keeping only clouds and rain
	// Lightning impact effect function removed - keeping only clouds and rain
	// Create rain effect
	function createRaindrop() {
		var raindrop = LK.getAsset('lightning', {
			anchorX: 0.5,
			anchorY: 0.5,
			x: Math.random() * 2200,
			y: -50,
			alpha: 0.3 + Math.random() * 0.3,
			rotation: Math.PI / 4 + (Math.random() * 0.2 - 0.1),
			// Angled rain
			width: 1.5 + Math.random() * 1.5,
			// Smaller width
			height: 10 + Math.random() * 15,
			// Smaller height
			tint: 0x88AAFF
		});
		raindrop.speed = 6 + Math.random() * 6; // Slower speed
		raindrop.wind = self.windStrength + (Math.random() * 2 - 1);
		self.rainContainer.addChild(raindrop);
		self.raindrops.push(raindrop);
		return raindrop;
	}
	// Update rain state
	function updateRain() {
		// Update existing raindrops
		for (var i = self.raindrops.length - 1; i >= 0; i--) {
			var drop = self.raindrops[i];
			drop.y += drop.speed;
			drop.x += drop.wind;
			// Remove raindrops that are off-screen
			if (drop.y > 2732 + 50) {
				self.rainContainer.removeChild(drop);
				self.raindrops.splice(i, 1);
			}
		}
		// Add new raindrops based on intensity, but fewer of them
		var dropCount = Math.floor(self.rainIntensity * 1.5); // Reduced multiplier
		for (var i = 0; i < dropCount; i++) {
			if (Math.random() < 0.7) {
				// Only 70% chance to create each drop
				createRaindrop();
			}
		}
	}
	// Weather transition system
	function updateWeatherState(deltaTime) {
		self.stateTimer -= deltaTime;
		if (self.stateTimer <= 0) {
			// Transition to next weather state
			if (self.currentWeatherState === self.weatherStates.BUILDING) {
				self.currentWeatherState = self.weatherStates.PEAK;
				self.stateTimer = 45000; // 45 seconds of peak storm
			} else if (self.currentWeatherState === self.weatherStates.PEAK) {
				self.currentWeatherState = self.weatherStates.DISSIPATING;
				self.stateTimer = 40000; // 40 seconds to dissipate
			} else if (self.currentWeatherState === self.weatherStates.DISSIPATING) {
				// Cycle back to building
				self.currentWeatherState = self.weatherStates.BUILDING;
				self.stateTimer = 30000;
			}
		}
		// Update storm parameters based on current state
		if (self.currentWeatherState === self.weatherStates.BUILDING) {
			// Gradually increase intensity
			self.stormIntensity = Math.min(0.7, self.stormIntensity + 0.0003 * deltaTime);
			self.rainIntensity = Math.min(0.6, self.rainIntensity + 0.0004 * deltaTime);
			self.windStrength = Math.min(3, self.windStrength + 0.0002 * deltaTime);
		} else if (self.currentWeatherState === self.weatherStates.PEAK) {
			// Maximum intensity with fluctuations
			self.stormIntensity = 0.9 + Math.sin(LK.ticks / 100) * 0.1;
			self.rainIntensity = 0.8 + Math.sin(LK.ticks / 120) * 0.2;
			self.windStrength = 4 + Math.sin(LK.ticks / 80) * 2;
		} else if (self.currentWeatherState === self.weatherStates.DISSIPATING) {
			// Gradually decrease intensity
			self.stormIntensity = Math.max(0.1, self.stormIntensity - 0.0004 * deltaTime);
			self.rainIntensity = Math.max(0.05, self.rainIntensity - 0.0003 * deltaTime);
			self.windStrength = Math.max(0.5, self.windStrength - 0.0005 * deltaTime);
		}
	}
	self.update = function () {
		// Calculate elapsed time since last update
		var currentTime = LK.ticks / 60 * 1000; // Convert ticks to milliseconds
		var deltaTime = self.lastUpdateTime === 0 ? 0 : currentTime - self.lastUpdateTime;
		self.lastUpdateTime = currentTime;
		// Update weather state
		updateWeatherState(deltaTime);
		// Update rain
		updateRain();
		// Lightning system removed - keeping only clouds and rain
		// Update cloud transformation system - only during active waves with enemies spawning
		if (waveInProgress && enemies.length > 0) {
			self.cloudTransformationTimer += deltaTime;
			if (self.cloudTransformationTimer >= self.nextTransformationTime) {
				self.transformCloudToEnemy();
			}
		} else {
			// Reset timer when no wave is active
			self.cloudTransformationTimer = 0;
		}
		// Update cloud movement with aggressive movement and wicked styling (no distortion)
		for (var i = 0; i < self.clouds.length; i++) {
			var cloud = self.clouds[i];
			// More aggressive turbulence for menacing movement (reduced intensity to avoid distortion)
			cloud.turbPhase += 0.04 + Math.random() * 0.02; // Faster, more chaotic phase changes
			var turbulenceY = Math.sin(cloud.turbPhase) * cloud.turbulence * 1.5; // Moderate turbulence intensity
			var turbulenceX = Math.cos(cloud.turbPhase * 1.3) * cloud.turbulence * 1; // Moderate horizontal turbulence
			// Add layered movement for massive fleet effect
			var layerOffset = Math.sin(LK.ticks / 60 + cloud.fleetLayer * Math.PI / 1.5) * 30; // Different layers move in waves
			cloud.y = cloud.baseY + turbulenceY + layerOffset;
			cloud.x += turbulenceX;
			// Apply much more aggressive horizontal movement with layer-based speed variation
			var layerSpeedMultiplier = 1 + cloud.fleetLayer * 0.5; // Different layers move at different speeds
			cloud.x += cloud.speedX * self.windStrength * 2 * layerSpeedMultiplier; // Reduced from 4x to 2x speed for slower movement
			// Add wicked color pulsing based on storm intensity
			var wickedTintBase = 0x220000; // Dark red base
			var intensityFactor = self.stormIntensity;
			var redComponent = Math.floor(0x22 + 0x88 * intensityFactor * (1 + Math.sin(LK.ticks / 30) * 0.3)); // Pulsing red
			var wickedTint = (redComponent << 16) + (0x11 << 8) + 0x11; // Dark red with hints of other colors
			cloud.tint = wickedTint;
			// Keep original cloud scale without distortion effects
			// Wrap clouds around the screen with more aggressive respawning for massive fleet
			if (cloud.x > 2048 + cloud.width * 3) {
				cloud.x = -cloud.width * 3;
				cloud.baseY = Math.random() * 800; // Randomize base Y position on wrap for massive fleet coverage
				cloud.y = cloud.baseY;
			} else if (cloud.x < -cloud.width * 3) {
				cloud.x = 2048 + cloud.width * 3;
				cloud.baseY = Math.random() * 800; // Randomize base Y position on wrap for massive fleet coverage
				cloud.y = cloud.baseY;
			}
		}
	};
	// Function to create spectacular cloud base impact
	self.createCloudBaseImpact = function (selectedCloud) {
