					// Remove the original cloud and transformation effect
					self.cloudsContainer.removeChild(selectedCloud);
					self.cloudsContainer.removeChild(transformationEffect);
					self.clouds.splice(randomIndex, 1);
					// Create replacement cloud to maintain fleet size
					var newCloud = self.attachAsset('thunderCloud', {
						anchorX: 0.5,
						anchorY: 0.5,
						x: Math.random() * 3600 - 800,
						y: Math.random() * 800,
						alpha: 0.8 + Math.random() * 0.2,
						scaleX: 0.5 + Math.random() * 1.8,
						scaleY: 0.4 + Math.random() * 1.2
					});
					var wickedColors = [0x330000, 0x220011, 0x110022, 0x440000, 0x331111];
					var cloudTint = wickedColors[Math.floor(Math.random() * wickedColors.length)];
					newCloud.tint = cloudTint;
					newCloud._originalTint = cloudTint;
					newCloud.speedX = (Math.random() * 3 - 1.5) * 2.0;
					newCloud.turbulence = 0.3 + Math.random() * 1.2;
					newCloud.turbPhase = Math.random() * Math.PI * 2;
					newCloud.lightningProbability = 0.4 + Math.random() * 0.6;
