		if (gold >= self.getUpgradeCost()) {
			gold -= self.getUpgradeCost();
			goldText.setText("Gold: " + gold);
			self.level++;
			self.stonePerCollection += 2; // Collect 2 more stone per cycle
			self.range += 20; // Increase collection range
			self.fireRate *= 0.85; // Collect faster
			// Update range indicator
			self.children[0].width = self.range * 2;
			self.children[0].height = self.range * 2;
			towerGraphic.tint = self.level === 2 ? 0x556070 : 0x445060;
			LK.effects.flashObject(self, 0x708090, 300);
