emTowerButton.x = 25;
emTowerButton.y = 20; // Position at top of sidebar
emTowerButton.onClick = function () {
	if (gold >= 65 && !isPlacingTower) {
		// Enhanced button press animation
		tween(emTowerButton, {
			scaleX: 0.95,
			scaleY: 0.95
		}, {
			duration: 100,
			onFinish: function onFinish() {
				tween(emTowerButton, {
					scaleX: 1.0,
					scaleY: 1.0
				}, {
					duration: 150,
					easing: tween.elasticOut
				});
			}
		});
		// Success purchase effects
		var purchaseSuccess = LK.getAsset('fire', {
			anchorX: 0.5,
			anchorY: 0.5,
			x: emTowerButton.x,
			y: emTowerButton.y,
			alpha: 0.8,
			tint: 0x00AAFF,
			scaleX: 0.5,
			scaleY: 0.5
		});
		LK.gui.topRight.addChild(purchaseSuccess);
		tween(purchaseSuccess, {
			alpha: 0,
			scaleX: 2.0,
			scaleY: 2.0
		}, {
			duration: 600,
			onFinish: function onFinish() {
				LK.gui.topRight.removeChild(purchaseSuccess);
			}
		});
		isPlacingTower = true;
		selectedTowerIndex = 4; // Index of EM tower in availableTurrets
		// Create tower placement indicator with EM tower tint
		placingTowerIndicator = LK.getAsset('tower', {
			anchorX: 0.5,
			anchorY: 1.0,
			alpha: 0.5,
			tint: 0x00AAFF // Blue tint for EM tower
		});
		game.addChild(placingTowerIndicator);
		// Deselect any selected tower
		if (selectedTower) {
			selectedTower.deselect();
			selectedTower = null;
		}
	} else {
		// Insufficient funds feedback
		var errorEffect = LK.getAsset('fire', {
			anchorX: 0.5,
			anchorY: 0.5,
			x: emTowerButton.x,
			y: emTowerButton.y,
			alpha: 0.7,
			tint: 0xFF4444,
			scaleX: 0.3,
			scaleY: 0.3
		});
		LK.gui.topRight.addChild(errorEffect);
		tween(errorEffect, {
			alpha: 0,
			y: emTowerButton.y - 30,
			scaleX: 1.0,
			scaleY: 1.0
		}, {
			duration: 800,
			onFinish: function onFinish() {
				LK.gui.topRight.removeChild(errorEffect);
			}
		});
		// Button shake effect for error
		var originalX = emTowerButton.x;
		tween(emTowerButton, {
			x: originalX - 5
		}, {
			duration: 50,
			onFinish: function onFinish() {
				tween(emTowerButton, {
					x: originalX + 5
				}, {
					duration: 50,
					onFinish: function onFinish() {
						tween(emTowerButton, {
							x: originalX
						}, {
							duration: 50
						});
					}
				});
			}
		});
	}
};
