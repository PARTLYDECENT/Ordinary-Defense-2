/**** 
* Plugins
****/
var tween = LK.import("@upit/tween.v1");
var storage = LK.import("@upit/storage.v1", {
	highScore: 0,
	gold: 100
});

/**** 
* Classes
****/
var Bullet = Container.expand(function (startX, startY, targetEnemy, damage, damageSource) {
	var self = Container.call(this);
	self.damageSource = damageSource;
	self.speed = 5;
	self.target = targetEnemy;
	self.damage = damage || 20;
	self.x = startX;
	self.y = startY;
	self.height = 15; // Base height for shadow calculation
	// Create drop shadow for bullet
	var bulletShadow = self.attachAsset('bullet', {
		anchorX: 0.5,
		anchorY: 0.5,
		alpha: 0.3,
		tint: 0x000000,
		scaleX: 0.8,
		scaleY: 0.6
	});
	// Position shadow offset based on height
	bulletShadow.x = 3 + self.height * 0.2;
	bulletShadow.y = 3 + self.height * 0.2;
	var bulletGraphic = self.attachAsset('bullet', {
		anchorX: 0.5,
		anchorY: 0.5
	});
	self.update = function () {
		if (!self.target || self.target.isDead) {
			self.destroy();
			return;
		}
		// Update shadow position based on bullet height and movement
		if (self.children[0]) {
			// First child is shadow
			var shadow = self.children[0];
			// Animate shadow based on bullet trajectory for 3D effect
			shadow.x = 3 + self.height * 0.2 + Math.sin(LK.ticks * 0.1) * 2;
			shadow.y = 3 + self.height * 0.2 + Math.cos(LK.ticks * 0.1) * 1;
			// Adjust shadow opacity based on height
			shadow.alpha = 0.3 + self.height * 0.01;
		}
		var dx = self.target.x - self.x;
		var dy = self.target.y - self.y;
		var distance = Math.sqrt(dx * dx + dy * dy);
		if (distance < 5) {
			if (self.isBomb) {
				// Area damage for bomb tower
				var impactX = self.target.x;
				var impactY = self.target.y;
				// Create explosion effect
				var explosion = LK.getAsset('fire', {
					anchorX: 0.5,
					anchorY: 0.5,
					x: impactX,
					y: impactY,
					alpha: 0.9,
					tint: 0xFF7700
				});
				game.addChild(explosion);
				tween(explosion, {
					alpha: 0,
					scaleX: self.splashRadius / 50,
					scaleY: self.splashRadius / 50
				}, {
					duration: 800,
					onFinish: function onFinish() {
						explosion.destroy();
					}
				});
				// Damage all enemies in the splash radius
				for (var i = 0; i < enemies.length; i++) {
					if (!enemies[i].isDead) {
						var targetDx = enemies[i].x - impactX;
						var targetDy = enemies[i].y - impactY;
						var targetDistance = Math.sqrt(targetDx * targetDx + targetDy * targetDy);
						if (targetDistance <= self.splashRadius) {
							// Calculate damage falloff based on distance
							var damagePercent = 1 - targetDistance / self.splashRadius;
							var damageAmount = Math.floor(self.damage * damagePercent);
							// Create a virtual damage source at explosion center for directional check
							var explosionSource = {
								x: impactX,
								y: impactY
							};
							enemies[i].takeDamage(damageAmount, explosionSource);
						}
					}
				}
			} else {
				// Normal damage for standard tower - check if damage was actually applied
				var damageApplied = self.target.takeDamage(self.damage, self.damageSource);
				if (!damageApplied) {
					// If damage was deflected, don't destroy bullet immediately - let it bounce off
					var bounceAngle = Math.atan2(self.target.y - self.y, self.target.x - self.x) + Math.PI;
					self.target = null; // Clear target so bullet will fly away
					// Add some randomness to bounce
					bounceAngle += (Math.random() - 0.5) * 0.5;
					self.x += Math.cos(bounceAngle) * 20;
					self.y += Math.sin(bounceAngle) * 20;
					return; // Don't destroy bullet yet
				}
			}
			self.destroy();
		} else {
			// Bomb bullets move slower
			var speedModifier = self.isBomb ? 0.7 : 1.0;
			self.x += dx / distance * self.speed * speedModifier;
			self.y += dy / distance * self.speed * speedModifier;
			// Leave trail effect for bomb bullets
			if (self.isBomb && Math.random() < 0.3) {
				var trail = LK.getAsset('fire', {
					anchorX: 0.5,
					anchorY: 0.5,
					x: self.x,
					y: self.y,
					alpha: 0.4,
					tint: 0xFF8800,
					scaleX: 0.3,
					scaleY: 0.3
				});
				game.addChild(trail);
				tween(trail, {
					alpha: 0,
					scaleX: 0.1,
					scaleY: 0.1
				}, {
					duration: 300,
					onFinish: function onFinish() {
						trail.destroy();
					}
				});
			}
		}
	};
	return self;
});
var Button = Container.expand(function (text, width, height, color, imageAsset) {
	var self = Container.call(this);
	self.width = width || 100;
	self.height = height || 50;
	self.color = color || 0x4444cc;
	self.isEnabled = true;
	self.imageAsset = imageAsset;
	// Use image asset if provided, otherwise use default button
	var assetName = self.imageAsset || 'upgradeButton';
	var buttonGraphic = self.attachAsset(assetName, {
		anchorX: 0.5,
		anchorY: 0.5
	});
	buttonGraphic.width = self.width;
	buttonGraphic.height = self.height;
	if (!self.imageAsset) {
		buttonGraphic.tint = self.color;
	}
	var buttonText = new Text2(text, {
		size: self.imageAsset ? 28 : 24,
		fill: 0xFFFFFF
	});
	buttonText.anchor.set(0.5, 0.5);
	self.addChild(buttonText);
	self.setText = function (newText) {
		buttonText.setText(newText);
	};
	self.setEnabled = function (enabled) {
		self.isEnabled = enabled;
		buttonGraphic.alpha = enabled ? 1.0 : 0.5;
		buttonText.alpha = enabled ? 1.0 : 0.5;
	};
	self.down = function (x, y, obj) {
		if (self.isEnabled && self.onClick) {
			LK.effects.flashObject(buttonGraphic, 0xffffff, 200);
			self.onClick();
		}
	};
	return self;
});
var Enemy = Container.expand(function (health, speed, reward) {
	var self = Container.call(this);
	self.health = health || 100;
	self.maxHealth = self.health;
	self.speed = speed || 0.5;
	self.reward = reward || 10;
	self.pathIndex = 0;
	self.isDead = false;
	self.height = 25; // Base height for shadow calculation
	// Animation cycling properties
	self.animationFrames = ['enemyImage', 'enemyImage2', 'enemyImage3'];
	self.currentFrameIndex = 0;
	self.animationTimer = 0;
	self.animationSpeed = 10; // Change frame every 10 ticks
	// Create layered drop shadow system for enemy
	var enemyShadowBase = self.attachAsset('enemyImage', {
		anchorX: 0.5,
		anchorY: 0.5,
		alpha: 0.2,
		tint: 0x000000,
		scaleX: 1.2,
		scaleY: 0.4
	});
	// Position base shadow
	enemyShadowBase.x = 4 + self.height * 0.3;
	enemyShadowBase.y = 8 + self.height * 0.3;
	// Create secondary softer shadow for depth
	var enemyShadowSoft = self.attachAsset('enemyImage', {
		anchorX: 0.5,
		anchorY: 0.5,
		alpha: 0.1,
		tint: 0x000000,
		scaleX: 1.4,
		scaleY: 0.3
	});
	// Position soft shadow further
	enemyShadowSoft.x = 6 + self.height * 0.4;
	enemyShadowSoft.y = 10 + self.height * 0.4;
	var enemyGraphic = self.attachAsset('enemyImage', {
		anchorX: 0.5,
		anchorY: 0.5,
		alpha: 1.0,
		visible: true,
		scaleX: 1.0,
		scaleY: 1.0
	});
	// Add directional armor indicator - shows protected rear area
	var armorIndicator = LK.getAsset('rangeIndicator', {
		anchorX: 0.5,
		anchorY: 0.5,
		x: 0,
		y: 0,
		alpha: 0.2,
		tint: 0xFF0000,
		// Red to show protected area
		width: 60,
		height: 60,
		rotation: Math.PI // Point backwards
	});
	self.addChild(armorIndicator);
	self.armorIndicator = armorIndicator;
	var healthBarBg = self.attachAsset('healthBarBg', {
		anchorX: 0.5,
		anchorY: 0.5,
		x: -30,
		y: -40,
		width: 60,
		height: 8,
		color: 0x000000
	});
	var healthBar = self.attachAsset('healthBar', {
		anchorX: 0.5,
		anchorY: 0.5,
		x: -30,
		y: -40,
		width: 60,
		height: 8,
		color: 0x00ff00
	});
	self.addChild(healthBarBg);
	self.addChild(healthBar);
	self.update = function () {
		if (self.isDead) {
			return;
		}
		// Update shadow system based on enemy health and movement
		if (self.children.length >= 2) {
			var baseShadow = self.children[0]; // First shadow
			var softShadow = self.children[1]; // Second shadow
			// Adjust shadow intensity based on health
			var healthPercent = self.health / self.maxHealth;
			baseShadow.alpha = 0.2 + healthPercent * 0.1;
			softShadow.alpha = 0.1 + healthPercent * 0.05;
			// Animate shadows with subtle movement for life-like effect
			baseShadow.x = 4 + self.height * 0.3 + Math.sin(LK.ticks * 0.05) * 1;
			baseShadow.y = 8 + self.height * 0.3 + Math.cos(LK.ticks * 0.03) * 0.5;
			softShadow.x = 6 + self.height * 0.4 + Math.sin(LK.ticks * 0.03) * 1.5;
			softShadow.y = 10 + self.height * 0.4 + Math.cos(LK.ticks * 0.02) * 0.8;
			// Adjust shadow scale based on movement speed for dynamic effect
			var speedFactor = 1 + self.speed * 0.1;
			baseShadow.scaleX = 1.2 * speedFactor;
			softShadow.scaleX = 1.4 * speedFactor;
		}
		// Animation cycling system - 3 seconds per switch with very slow fade transitions
		self.animationTimer++;
		if (self.animationTimer >= self.animationSpeed * 30) {
			// 30x slower switching (3 seconds at 60fps = 180 ticks, 180/6 = 30)
			self.animationTimer = 0;
			self.currentFrameIndex = (self.currentFrameIndex + 1) % self.animationFrames.length;
			// Create new graphic with fade-in effect
			var newAssetName = self.animationFrames[self.currentFrameIndex];
			var newGraphic = self.attachAsset(newAssetName, {
				anchorX: 0.5,
				anchorY: 0.5,
				alpha: 0 // Start invisible for fade-in
			});
			// Update shadows to match new graphic
			if (self.children.length >= 2) {
				// Update shadow graphics to match new animation frame
				var newBaseShadow = self.attachAsset(newAssetName, {
					anchorX: 0.5,
					anchorY: 0.5,
					alpha: 0.2,
					tint: 0x000000,
					scaleX: 1.2,
					scaleY: 0.4
				});
				newBaseShadow.x = self.children[0].x;
				newBaseShadow.y = self.children[0].y;
				self.removeChild(self.children[0]);
				self.addChildAt(newBaseShadow, 0);
				var newSoftShadow = self.attachAsset(newAssetName, {
					anchorX: 0.5,
					anchorY: 0.5,
					alpha: 0.1,
					tint: 0x000000,
					scaleX: 1.4,
					scaleY: 0.3
				});
				newSoftShadow.x = self.children[1].x;
				newSoftShadow.y = self.children[1].y;
				self.removeChild(self.children[1]);
				self.addChildAt(newSoftShadow, 1);
			}
			// Fade out current graphic while fading in new one
			tween(enemyGraphic, {
				alpha: 0
			}, {
				duration: 1500,
				// Very slow fade out over 1.5 seconds
				easing: tween.easeOut
			});
			// Fade in new graphic
			tween(newGraphic, {
				alpha: 1
			}, {
				duration: 1500,
				// Very slow fade in over 1.5 seconds
				easing: tween.easeIn,
				onFinish: function onFinish() {
					// Remove old graphic after fade completes
					self.removeChild(enemyGraphic);
					enemyGraphic = newGraphic;
					// Re-add armor indicator and health bars after the new graphic
					self.addChild(self.armorIndicator);
					self.addChild(self.children[1]); // healthBarBg
					self.addChild(self.children[2]); // healthBar
				}
			});
		}
		// Add subtle bobbing animation for more life-like movement
		self.bobPhase = (self.bobPhase || 0) + 0.15;
		var bobOffset = Math.sin(self.bobPhase) * 2;
		// Initialize trail system if not already done
		if (!self.trailTimer) {
			self.trailTimer = 0;
		}
		self.trailTimer++;
		if (self.pathIndex < gamePath.length - 1) {
			var targetPoint = gamePath[self.pathIndex + 1];
			// Add chaotic path deviation - create random offset waypoints
			if (!self.chaoticOffset) {
				self.chaoticOffset = {
					x: (Math.random() - 0.5) * 120,
					// Random offset up to 60px in each direction
					y: (Math.random() - 0.5) * 120,
					changeTimer: 0,
					changeInterval: 30 + Math.random() * 60 // Change offset every 0.5-1.5 seconds
				};
			}
			// Update chaotic offset more frequently for constant chaos
			self.chaoticOffset.changeTimer++;
			if (self.chaoticOffset.changeTimer >= self.chaoticOffset.changeInterval) {
				self.chaoticOffset.changeTimer = 0;
				self.chaoticOffset.changeInterval = 15 + Math.random() * 30; // More frequent changes
				// Tween to new chaotic offset with smaller range for smooth movement
				var newOffsetX = (Math.random() - 0.5) * 30; // Much smaller range for subtle deviation
				var newOffsetY = (Math.random() - 0.5) * 30; // Much smaller range for subtle deviation
				tween(self.chaoticOffset, {
					x: newOffsetX,
					y: newOffsetY
				}, {
					duration: 800 + Math.random() * 400,
					easing: tween.easeInOut
				});
			}
			// Apply chaotic offset to target point
			var chaoticTargetX = targetPoint.x + self.chaoticOffset.x;
			var chaoticTargetY = targetPoint.y + self.chaoticOffset.y;
			var dx = chaoticTargetX - self.x;
			var dy = chaoticTargetY - self.y;
			var distance = Math.sqrt(dx * dx + dy * dy);
			if (distance < 5) {
				self.pathIndex++;
				// Reset chaotic offset for next waypoint
				self.chaoticOffset = null;
				// Add path waypoint effect
				var waypointEffect = LK.getAsset('fire', {
					anchorX: 0.5,
					anchorY: 0.5,
					x: self.x,
					y: self.y,
					alpha: 0.4,
					tint: 0x88FF88,
					scaleX: 0.3,
					scaleY: 0.3
				});
				game.addChild(waypointEffect);
				tween(waypointEffect, {
					alpha: 0,
					scaleX: 1.0,
					scaleY: 1.0
				}, {
					duration: 300,
					onFinish: function onFinish() {
						waypointEffect.destroy();
					}
				});
			} else {
				var vx = dx / distance * self.speed;
				var vy = dy / distance * self.speed;
				// Initialize 3-phase chaotic path system with tile-like switching
				if (!self.chaoticPattern) {
					// Phase 1: Grid-based tile patterns
					var phase1Patterns = ['tile_grid', 'tile_diagonal', 'tile_cross'];
					// Phase 2: Fluid movement patterns  
					var phase2Patterns = ['fluid_wave', 'fluid_spiral', 'fluid_orbital'];
					// Phase 3: Erratic switching patterns
					var phase3Patterns = ['switch_rapid', 'switch_burst', 'switch_chaos'];
					self.allPatterns = [phase1Patterns, phase2Patterns, phase3Patterns];
					self.currentPhase = Math.floor(Math.random() * 3); // Start with random phase
					self.chaoticPattern = self.allPatterns[self.currentPhase][Math.floor(Math.random() * 3)];
					self.patternPhase = Math.random() * Math.PI * 2;
					self.patternIntensity = 8 + Math.random() * 12; // Much lower intensity for subtle movement
					self.phaseTimer = 0;
					self.phaseInterval = 60 + Math.random() * 120; // 1-3 seconds at 60fps
					self.tileSize = 40; // Size of virtual tiles for grid-based movement
					self.lastTileX = Math.floor(self.x / self.tileSize);
					self.lastTileY = Math.floor(self.y / self.tileSize);
				}
				// Update phase timer for random switching
				self.phaseTimer++;
				if (self.phaseTimer >= self.phaseInterval) {
					self.phaseTimer = 0;
					self.phaseInterval = 60 + Math.random() * 120;
					// Randomly switch to a different phase
					var newPhase = Math.floor(Math.random() * 3);
					if (newPhase !== self.currentPhase) {
						self.currentPhase = newPhase;
						self.chaoticPattern = self.allPatterns[self.currentPhase][Math.floor(Math.random() * 3)];
						// Create phase transition effect
						var transitionEffect = LK.getAsset('fire', {
							anchorX: 0.5,
							anchorY: 0.5,
							x: 0,
							y: 0,
							alpha: 0.6,
							tint: [0xFF4400, 0x00AAFF, 0xFF00FF][self.currentPhase],
							scaleX: 0.3,
							scaleY: 0.3
						});
						self.addChild(transitionEffect);
						tween(transitionEffect, {
							alpha: 0,
							scaleX: 1.5,
							scaleY: 1.5
						}, {
							duration: 400,
							onFinish: function onFinish() {
								self.removeChild(transitionEffect);
							}
						});
					}
				}
				// Apply chaotic pattern modifications based on current phase
				var chaoticX = 0,
					chaoticY = 0;
				self.patternPhase += 0.02 + Math.random() * 0.01; // Much slower pattern changes for smoother movement
				// Calculate current tile position
				var currentTileX = Math.floor(self.x / self.tileSize);
				var currentTileY = Math.floor(self.y / self.tileSize);
				var tileChanged = currentTileX !== self.lastTileX || currentTileY !== self.lastTileY;
				switch (self.chaoticPattern) {
					// Phase 1: Grid-based tile patterns
					case 'tile_grid':
						// Move in grid-locked directions with tile switching
						if (tileChanged || Math.random() < 0.6) {
							// Increased chance from 0.3 to 0.6
							var gridDirections = [[1, 0], [-1, 0], [0, 1], [0, -1], [1, 1], [-1, -1]];
							var gridDir = gridDirections[Math.floor(Math.random() * gridDirections.length)];
							chaoticX = gridDir[0] * self.tileSize * 0.1; // Reduced for subtle movement
							chaoticY = gridDir[1] * self.tileSize * 0.1; // Reduced for subtle movement
						} else {
							chaoticX = Math.sin(self.patternPhase) * 3; // Much smaller for gentle movement
							chaoticY = Math.cos(self.patternPhase) * 3; // Much smaller for gentle movement
						}
						break;
					case 'tile_diagonal':
						// Diagonal tile-based movement with switching
						var diagonalStrength = tileChanged ? self.patternIntensity * 0.8 : self.patternIntensity * 0.2;
						chaoticX = Math.sin(self.patternPhase + Math.PI / 4) * diagonalStrength;
						chaoticY = Math.cos(self.patternPhase + Math.PI / 4) * diagonalStrength;
						if (tileChanged) {
							chaoticX += (Math.random() - 0.5) * self.tileSize * 0.5;
							chaoticY += (Math.random() - 0.5) * self.tileSize * 0.5;
						}
						break;
					case 'tile_cross':
						// Cross pattern with tile anchoring
						var crossPhase = Math.floor(self.patternPhase / (Math.PI / 2)) % 4;
						switch (crossPhase) {
							case 0:
								chaoticX = self.patternIntensity;
								chaoticY = 0;
								break;
							case 1:
								chaoticX = 0;
								chaoticY = self.patternIntensity;
								break;
							case 2:
								chaoticX = -self.patternIntensity;
								chaoticY = 0;
								break;
							case 3:
								chaoticX = 0;
								chaoticY = -self.patternIntensity;
								break;
						}
						if (tileChanged) {
							// Snap to tile boundaries with random offset
							chaoticX += (currentTileX * self.tileSize - self.x) * 0.1;
							chaoticY += (currentTileY * self.tileSize - self.y) * 0.1;
						}
						break;
					// Phase 2: Fluid movement patterns
					case 'fluid_wave':
						chaoticX = Math.sin(self.patternPhase * 1.5) * self.patternIntensity * 0.8;
						chaoticY = Math.cos(self.patternPhase * 0.9) * self.patternIntensity;
						// Add flowing tile influence
						if (tileChanged) {
							chaoticX += Math.sin(currentTileX * 0.5) * 15;
							chaoticY += Math.cos(currentTileY * 0.5) * 15;
						}
						break;
					case 'fluid_spiral':
						var spiralRadius = Math.sin(self.patternPhase * 0.4) * self.patternIntensity;
						chaoticX = Math.cos(self.patternPhase * 1.2) * spiralRadius;
						chaoticY = Math.sin(self.patternPhase * 1.2) * spiralRadius;
						// Tile-based spiral modulation
						if (tileChanged) {
							var tileSpiral = (currentTileX + currentTileY) * 0.3;
							chaoticX += Math.cos(tileSpiral) * 20;
							chaoticY += Math.sin(tileSpiral) * 20;
						}
						break;
					case 'fluid_orbital':
						chaoticX = Math.cos(self.patternPhase) * self.patternIntensity * 0.6;
						chaoticY = Math.sin(self.patternPhase * 1.3) * self.patternIntensity * 0.8;
						// Orbital tile anchoring
						if (tileChanged) {
							var tileOrbit = Math.atan2(currentTileY - self.lastTileY, currentTileX - self.lastTileX);
							chaoticX += Math.cos(tileOrbit) * 25;
							chaoticY += Math.sin(tileOrbit) * 25;
						}
						break;
					// Phase 3: Erratic switching patterns
					case 'switch_rapid':
						// Rapid switching between tile positions
						if (Math.random() < 0.4 || tileChanged) {
							var switchTargets = [[self.tileSize, 0], [-self.tileSize, 0], [0, self.tileSize], [0, -self.tileSize], [self.tileSize, self.tileSize], [-self.tileSize, -self.tileSize]];
							var switchTarget = switchTargets[Math.floor(Math.random() * switchTargets.length)];
							chaoticX = switchTarget[0] * 0.4;
							chaoticY = switchTarget[1] * 0.4;
						} else {
							chaoticX = (Math.random() - 0.5) * self.patternIntensity * 0.5;
							chaoticY = (Math.random() - 0.5) * self.patternIntensity * 0.5;
						}
						break;
					case 'switch_burst':
						// Burst movement with tile snapping
						if (Math.random() < 0.2) {
							// Burst to random tile
							chaoticX = (Math.random() - 0.5) * self.tileSize * 1.5;
							chaoticY = (Math.random() - 0.5) * self.tileSize * 1.5;
						} else if (tileChanged) {
							// Tile change reaction
							chaoticX = Math.sin(currentTileX + currentTileY) * self.patternIntensity;
							chaoticY = Math.cos(currentTileX - currentTileY) * self.patternIntensity;
						} else {
							// Gentle movement
							chaoticX = Math.sin(self.patternPhase * 0.5) * 10;
							chaoticY = Math.cos(self.patternPhase * 0.7) * 10;
						}
						break;
					case 'switch_chaos':
						// Pure chaotic switching
						if (tileChanged) {
							// Major chaos on tile change
							chaoticX = (Math.random() - 0.5) * self.patternIntensity * 4; // Increased from 2 to 4
							chaoticY = (Math.random() - 0.5) * self.patternIntensity * 4; // Increased from 2 to 4
						} else {
							// Minor chaos between tiles
							chaoticX = (Math.random() - 0.5) * self.patternIntensity * 2.5; // Increased from 1.2 to 2.5
							chaoticY = (Math.random() - 0.5) * self.patternIntensity * 2.5; // Increased from 1.2 to 2.5
						}
						// Add random tile-aligned jerks
						if (Math.random() < 0.4) {
							// Increased chance from 0.15 to 0.4
							chaoticX += (currentTileX % 2 - 0.5) * self.tileSize * 1.5; // Increased from 0.6 to 1.5
							chaoticY += (currentTileY % 2 - 0.5) * self.tileSize * 1.5; // Increased from 0.6 to 1.5
						}
						break;
				}
				// Update tile tracking
				self.lastTileX = currentTileX;
				self.lastTileY = currentTileY;
				// Apply phase and pattern transitions with enhanced smoothing
				if (Math.random() < 0.08) {
					// 8% chance to change pattern within same phase
					var newPatternIndex = Math.floor(Math.random() * 3);
					var newPattern = self.allPatterns[self.currentPhase][newPatternIndex];
					if (newPattern !== self.chaoticPattern) {
						self.chaoticPattern = newPattern;
						var newIntensity = 20 + Math.random() * 30;
						tween(self, {
							patternIntensity: newIntensity
						}, {
							duration: 300 + Math.random() * 400,
							easing: tween.easeInOut
						});
					}
				}
				// Move enemy with subtle chaotic modifications for smooth movement
				self.x += vx + chaoticX * 0.02; // Very small modifier for subtle movement
				self.y += vy + chaoticY * 0.02 + bobOffset * 0.05; // Reduced chaos and bobbing
				// Keep enemy rotation always facing the player/camera (0 radians)
				self.rotation = 0;
				// Update armor indicator rotation to always point backwards (downwards)
				if (self.armorIndicator) {
					self.armorIndicator.rotation = Math.PI;
				}
				// Create enhanced chaotic particle trail effect
				if (self.trailTimer % 6 === 0) {
					// Create multiple trail particles for chaotic paths
					for (var t = 0; t < 2; t++) {
						var trailParticle = LK.getAsset('fire', {
							anchorX: 0.5,
							anchorY: 0.5,
							x: self.x + (Math.random() - 0.5) * 20,
							y: self.y + (Math.random() - 0.5) * 20,
							alpha: 0.4 + Math.random() * 0.3,
							tint: [0xFF6600, 0xFF4400, 0xFF8800][Math.floor(Math.random() * 3)],
							scaleX: 0.1 + Math.random() * 0.1,
							scaleY: 0.1 + Math.random() * 0.1
						});
						game.addChild(trailParticle);
						// Chaotic trail movement following the enemy's pattern
						var trailChaoticX = 0,
							trailChaoticY = 0;
						if (self.chaoticPattern === 'spiral') {
							trailChaoticX = Math.cos(self.patternPhase - t * 0.5) * 30;
							trailChaoticY = Math.sin(self.patternPhase - t * 0.5) * 30;
						} else if (self.chaoticPattern === 'zigzag') {
							trailChaoticX = Math.sin(self.patternPhase - t * 0.8) * 25;
							trailChaoticY = Math.cos(self.patternPhase - t * 0.6) * 15;
						} else {
							trailChaoticX = (Math.random() - 0.5) * 40;
							trailChaoticY = (Math.random() - 0.5) * 40;
						}
						// Animate trail particle with chaotic movement
						tween(trailParticle, {
							alpha: 0,
							scaleX: 0.02,
							scaleY: 0.02,
							x: trailParticle.x + trailChaoticX,
							y: trailParticle.y + trailChaoticY,
							rotation: Math.PI * 2
						}, {
							duration: 1500 + Math.random() * 500,
							easing: tween.easeOut,
							onFinish: function onFinish() {
								trailParticle.destroy();
							}
						});
					}
				}
			}
		} else {
			self.reachedBase();
		}
		// Smooth health bar animation
		var targetWidth = self.health / self.maxHealth * 60;
		tween(healthBar, {
			width: targetWidth
		}, {
			duration: 200,
			easing: tween.easeOut
		});
		// Health bar color changes based on health percentage
		var healthPercent = self.health / self.maxHealth;
		var healthColor = healthPercent > 0.7 ? 0x00FF00 : healthPercent > 0.3 ? 0xFFFF00 : 0xFF0000;
		if (healthBar.tint !== healthColor) {
			tween(healthBar, {
				tint: healthColor
			}, {
				duration: 300
			});
		}
	};
	self.takeDamage = function (damage, damageSource) {
		// Calculate angle from enemy to damage source to determine if attack is from behind
		if (damageSource && damageSource.x !== undefined && damageSource.y !== undefined) {
			var dx = damageSource.x - self.x;
			var dy = damageSource.y - self.y;
			var attackAngle = Math.atan2(dy, dx);
			// Normalize enemy rotation to compare with attack angle
			var enemyFacing = self.rotation || 0;
			var angleDifference = attackAngle - enemyFacing;
			// Normalize angle difference to -PI to PI range
			while (angleDifference > Math.PI) {
				angleDifference -= Math.PI * 2;
			}
			while (angleDifference < -Math.PI) {
				angleDifference += Math.PI * 2;
			}
			// Check if attack is from behind (roughly 120 degrees behind enemy)
			var isFromBehind = Math.abs(angleDifference) > Math.PI * 0.67; // About 120 degrees
			if (isFromBehind) {
				// Create deflection effect to show attack was blocked
				var deflectEffect = LK.getAsset('fire', {
					anchorX: 0.5,
					anchorY: 0.5,
					x: 0,
					y: 0,
					alpha: 0.8,
					tint: 0x888888,
					// Gray color for deflection
					scaleX: 0.3,
					scaleY: 0.3
				});
				self.addChild(deflectEffect);
				// Animate deflection effect
				tween(deflectEffect, {
					alpha: 0,
					scaleX: 1.2,
					scaleY: 1.2
				}, {
					duration: 400,
					onFinish: function onFinish() {
						self.removeChild(deflectEffect);
					}
				});
				// Show deflection text
				var deflectText = new Text2('DEFLECTED', {
					size: 24,
					fill: 0x888888
				});
				deflectText.anchor.set(0.5, 0.5);
				deflectText.x = 0;
				deflectText.y = -50;
				self.addChild(deflectText);
				// Animate deflection text
				tween(deflectText, {
					y: -80,
					alpha: 0
				}, {
					duration: 800,
					onFinish: function onFinish() {
						self.removeChild(deflectText);
					}
				});
				return false; // Attack was deflected, no damage taken
			}
		}
		self.health -= damage;
		self.lastHitBy = damageSource; // Track the last tower that hit this enemy
		// Remove enemy shake to keep movement smooth
		// Multi-layered hit effect with color cycling
		enemyGraphic.tint = 0xFFFFFF;
		tween(enemyGraphic, {
			tint: 0xFF0000
		}, {
			duration: 100,
			onFinish: function onFinish() {
				tween(enemyGraphic, {
					tint: 0xFFFF00
				}, {
					duration: 100,
					onFinish: function onFinish() {
						tween(enemyGraphic, {
							tint: 0xFFFFFF
						}, {
							duration: 200,
							easing: tween.easeOut
						});
					}
				});
			}
		});
		// Create expanding impact ring
		var impactRing = LK.getAsset('rangeIndicator', {
			anchorX: 0.5,
			anchorY: 0.5,
			x: 0,
			y: 0,
			alpha: 0.8,
			tint: 0xFF4400,
			width: 20,
			height: 20
		});
		self.addChild(impactRing);
		// Expanding ring animation
		tween(impactRing, {
			alpha: 0,
			width: 100,
			height: 100,
			scaleX: 1.5,
			scaleY: 1.5
		}, {
			duration: 400,
			easing: tween.easeOut,
			onFinish: function onFinish() {
				self.removeChild(impactRing);
			}
		});
		// Create damage number popup
		var damageText = new Text2('-' + damage, {
			size: 28,
			fill: 0xFF0000
		});
		damageText.anchor.set(0.5, 0.5);
		damageText.x = 0;
		damageText.y = -30;
		self.addChild(damageText);
		// Animate damage number
		tween(damageText, {
			y: -60,
			alpha: 0,
			scaleX: 1.2,
			scaleY: 1.2
		}, {
			duration: 800,
			easing: tween.easeOut,
			onFinish: function onFinish() {
				self.removeChild(damageText);
			}
		});
		// Create light effect with enhanced pulsing
		var lightEffect = LK.getAsset('fire', {
			anchorX: 0.5,
			anchorY: 0.5,
			x: 0,
			y: 0,
			alpha: 0.9,
			tint: 0xFF6600,
			scaleX: 0.5,
			scaleY: 0.5
		});
		self.addChild(lightEffect);
		// Enhanced pulsing animation
		tween(lightEffect, {
			alpha: 0.3,
			scaleX: 2.0,
			scaleY: 2.0
		}, {
			duration: 200,
			easing: tween.easeOut,
			onFinish: function onFinish() {
				tween(lightEffect, {
					alpha: 0,
					scaleX: 0.2,
					scaleY: 0.2
				}, {
					duration: 300,
					easing: tween.easeIn,
					onFinish: function onFinish() {
						self.removeChild(lightEffect);
					}
				});
			}
		});
		if (self.health <= 0 && !self.isDead) {
			self.isDead = true;
			// Automatically upgrade the tower that killed this enemy
			if (self.lastHitBy && typeof self.lastHitBy.upgrade === 'function') {
				self.lastHitBy.upgrade();
			}
			getRandomEnemyDieSound().play();
			// Play lore2 sound after killing the first enemy
			if (lore2PlayCount === 0) {
				LK.getSound('lore2').play();
				lore2PlayCount++;
			}
			gold += self.reward;
			goldText.setText("Gold: " + gold);
			LK.setScore(LK.getScore() + self.reward);
			scoreText.setText("Score: " + LK.getScore());
			LK.effects.flashObject(self, 0xff0000, 300);
			// Add enhanced particle effect for enemy destruction
			var destroyEffect = LK.getAsset('fire', {
				anchorX: 0.5,
				anchorY: 0.5,
				x: self.x,
				y: self.y,
				alpha: 0.8,
				tint: 0xFF4500 // Fiery explosion tint
			});
			game.addChild(destroyEffect);
			tween(destroyEffect, {
				alpha: 0,
				scaleX: 3.0,
				//{29} // Larger explosion
				scaleY: 3.0
			}, {
				duration: 700,
				//{2c} // Longer duration for realism
				onFinish: function onFinish() {
					destroyEffect.destroy();
				}
			});
			LK.setTimeout(function () {
				self.destroy();
			}, 300);
			return true;
		}
		return false;
	};
	self.reachedBase = function () {
		if (!self.isDead) {
			self.isDead = true;
			LK.getSound('baseHit').play();
			playerLives--;
			livesText.setText("Lives: " + playerLives);
			if (playerLives <= 0) {
				if (LK.getScore() > storage.highScore) {
					storage.highScore = LK.getScore();
				}
				LK.effects.flashScreen(0xff0000, 1000);
				LK.showGameOver();
			} else {
				// Advance to next level when enemy reaches base
				if (currentLevel < 10) {
					currentLevel++;
					waveNumber = 0;
					waveText.setText("Level: " + currentLevel + " Wave: " + waveNumber);
					initGame();
					// Auto-start the first wave of the new level after a delay
					LK.setTimeout(function () {
						startNextWave();
					}, 1000);
				} else {
					// Player has completed all 10 levels
					LK.showYouWin();
				}
			}
			// Add advanced explosion effect for enemy reaching the base
			// Stage 1: Core explosion
			var baseExplosion = LK.getAsset('fire', {
				anchorX: 0.5,
				anchorY: 0.5,
				x: self.x,
				y: self.y,
				alpha: 0.95,
				tint: 0xFF6600,
				scaleX: 1.0,
				scaleY: 1.0
			});
			game.addChild(baseExplosion);
			tween(baseExplosion, {
				alpha: 0.7,
				scaleX: 2.5,
				scaleY: 2.5
			}, {
				duration: 180,
				onFinish: function onFinish() {
					// Stage 2: Shockwave ring
					var shockwave = LK.getAsset('rangeIndicator', {
						anchorX: 0.5,
						anchorY: 0.5,
						x: self.x,
						y: self.y,
						alpha: 0.4,
						tint: 0xFFCC00,
						width: 40,
						height: 40
					});
					game.addChild(shockwave);
					tween(shockwave, {
						alpha: 0,
						width: 180,
						height: 180
					}, {
						duration: 400,
						onFinish: function onFinish() {
							shockwave.destroy();
						}
					});
					// Stage 3: Debris particles
					for (var i = 0; i < 6; i++) {
						(function (angle) {
							var debris = LK.getAsset('fire', {
								anchorX: 0.5,
								anchorY: 0.5,
								x: self.x,
								y: self.y,
								alpha: 0.7,
								tint: 0xFF8800,
								scaleX: 0.2,
								scaleY: 0.2
							});
							game.addChild(debris);
							var dist = 60 + Math.random() * 40;
							var dx = Math.cos(angle) * dist;
							var dy = Math.sin(angle) * dist;
							tween(debris, {
								x: self.x + dx,
								y: self.y + dy,
								alpha: 0,
								scaleX: 0.1,
								scaleY: 0.1
							}, {
								duration: 400 + Math.random() * 200,
								onFinish: function onFinish() {
									debris.destroy();
								}
							});
						})(Math.PI * 2 * i / 6 + Math.random() * 0.3);
					}
					// Stage 4: Fade out core explosion
					tween(baseExplosion, {
						alpha: 0,
						scaleX: 3.5,
						scaleY: 3.5
					}, {
						duration: 350,
						onFinish: function onFinish() {
							baseExplosion.destroy();
						}
					});
				}
			});
			// Remove screen shake to keep display stable
			self.destroy();
		}
	};
	return self;
});
var FastEnemy = Enemy.expand(function (reward) {
	var self = Enemy.call(this, 50, 2.0, reward || 15);
	// Lower health, higher speed, better reward
	// Override the enemy graphic with a different image
	self.removeChild(self.children[0]); // Remove default enemy graphic
	var enemyGraphic = self.attachAsset('enemyImage2', {
		anchorX: 0.5,
		anchorY: 0.5,
		tint: 0x00FFFF,
		// Cyan tint for fast enemy
		scaleX: 0.8,
		scaleY: 0.8,
		alpha: 1.0,
		visible: true
	});
	// Override update to add enhanced fast enemy trail
	var originalUpdate = self.update;
	self.update = function () {
		originalUpdate.call(self);
		// Enhanced chaotic trail for fast enemies with lightning-fast patterns
		if (self.trailTimer % 3 === 0) {
			// Super frequent chaotic trail particles
			for (var ft = 0; ft < 3; ft++) {
				var fastTrail = LK.getAsset('fire', {
					anchorX: 0.5,
					anchorY: 0.5,
					x: self.x + (Math.random() - 0.5) * 25,
					y: self.y + (Math.random() - 0.5) * 25,
					alpha: 0.6 + Math.random() * 0.3,
