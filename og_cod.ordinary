			duration: 1000,
			onFinish: function onFinish() {
				self.removeChild(stoneText);
			}
		});
		getRandomShootSound().play();
		LK.effects.flashObject(towerGraphic, 0x708090, 150);
		return true;
	};
	// Override findTarget to always return true (always collect)
	self.findTarget = function (enemies) {
		return true; // Always collect resources
	};
	// Override upgrade to improve collection capabilities
