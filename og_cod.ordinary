ordinaryTechButton.onClick = function () {
	// Use LK.openUrl for cross-platform compatibility (mobile, web, desktop)
	if (typeof LK.openUrl === "function") {
		LK.openUrl("https://partlydecent.github.io/ORDINARY-TECHNOLOGY/");
	} else if (typeof window !== "undefined" && window.open) {
		window.open("https://partlydecent.github.io/ORDINARY-TECHNOLOGY/", "_blank");
	}
};
