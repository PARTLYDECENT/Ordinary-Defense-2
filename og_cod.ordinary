// Move Defense Grid button to sidebar
var defenseGridButton = new Button('Defense Grid\n120g', 400, 100, 0x00FF88, 'emTowerButton');
sidebarContainer.addChild(defenseGridButton);
defenseGridButton.x = 25;
defenseGridButton.y = 120; // Position in sidebar
defenseGridButton.onClick = function () {
	if (gold >= 120 && !isPlacingTower) {
		// Force field activation animation
		tween(defenseGridButton, {
			scaleX: 0.9,
			scaleY: 0.9
		}, {
			duration: 80,
			onFinish: function onFinish() {
				tween(defenseGridButton, {
					scaleX: 1.1,
					scaleY: 1.1
				}, {
					duration: 120,
					onFinish: function onFinish() {
						tween(defenseGridButton, {
							scaleX: 1.0,
							scaleY: 1.0
						}, {
							duration: 100,
							easing: tween.elasticOut
						});
					}
				});
			}
		});
		// Force field activation effect
		var forceFieldRing = LK.getAsset('rangeIndicator', {
			anchorX: 0.5,
			anchorY: 0.5,
			x: defenseGridButton.x,
			y: defenseGridButton.y,
			alpha: 0.6,
			tint: 0x00FF88,
			width: 30,
			height: 30
		});
		LK.gui.topRight.addChild(forceFieldRing);
		tween(forceFieldRing, {
			alpha: 0,
			width: 200,
			height: 200
		}, {
			duration: 800,
			easing: tween.easeOut,
			onFinish: function onFinish() {
				LK.gui.topRight.removeChild(forceFieldRing);
			}
		});
		isPlacingTower = true;
		selectedTowerIndex = 6; // Index of Defense Grid in availableTurrets
		// Create tower placement indicator with Defense Grid tint
		placingTowerIndicator = LK.getAsset('tower', {
			anchorX: 0.5,
			anchorY: 1.0,
			alpha: 0.5,
			tint: 0x00FF88 // Green-cyan tint for Defense Grid
		});
		game.addChild(placingTowerIndicator);
		// Deselect any selected tower
		if (selectedTower) {
			selectedTower.deselect();
			selectedTower = null;
		}
	} else {
		// Insufficient funds feedback with force field error effect
		var errorField = LK.getAsset('rangeIndicator', {
			anchorX: 0.5,
			anchorY: 0.5,
			x: defenseGridButton.x,
			y: defenseGridButton.y,
			alpha: 0.8,
			tint: 0xFF4444,
			width: 40,
			height: 40
		});
		LK.gui.topRight.addChild(errorField);
		tween(errorField, {
			alpha: 0,
			width: 120,
			height: 120
		}, {
			duration: 600,
			onFinish: function onFinish() {
				LK.gui.topRight.removeChild(errorField);
			}
		});
		// Enhanced shake effect for Defense Grid
		var originalX = defenseGridButton.x;
		var shakeCount = 0;
		var maxShakes = 4;
		var _performShake = function performShake() {
			if (shakeCount < maxShakes) {
				tween(defenseGridButton, {
					x: originalX + (shakeCount % 2 === 0 ? -10 : 10)
				}, {
					duration: 50,
					onFinish: function onFinish() {
						shakeCount++;
						_performShake();
					}
				});
			} else {
				tween(defenseGridButton, {
					x: originalX
				}, {
					duration: 100,
					easing: tween.easeOut
				});
			}
		};
		_performShake();
	}
};
// Move Drone Factory button to sidebar
var droneFactoryButton = new Button('Drone Factory\n80g', 400, 100, 0x55FF55, 'droneFactoryButton');
sidebarContainer.addChild(droneFactoryButton);
droneFactoryButton.x = 25;
droneFactoryButton.y = 220; // Position in sidebar
droneFactoryButton.onClick = function () {
	if (gold >= 80 && !isPlacingTower) {
		// Enhanced button press animation with bounce
		tween(droneFactoryButton, {
			scaleX: 0.9,
			scaleY: 0.9
		}, {
			duration: 80,
			onFinish: function onFinish() {
				tween(droneFactoryButton, {
					scaleX: 1.05,
					scaleY: 1.05
				}, {
					duration: 120,
					onFinish: function onFinish() {
						tween(droneFactoryButton, {
							scaleX: 1.0,
							scaleY: 1.0
						}, {
							duration: 100,
							easing: tween.elasticOut
						});
					}
				});
			}
		});
		// Multi-stage purchase confirmation effect
		var confirmationRing = LK.getAsset('rangeIndicator', {
			anchorX: 0.5,
			anchorY: 0.5,
			x: droneFactoryButton.x,
			y: droneFactoryButton.y,
			alpha: 0.6,
			tint: 0x55FF55,
			width: 50,
			height: 50
		});
		LK.gui.topRight.addChild(confirmationRing);
		tween(confirmationRing, {
			alpha: 0,
			width: 300,
			height: 300
		}, {
			duration: 700,
			easing: tween.easeOut,
			onFinish: function onFinish() {
				LK.gui.topRight.removeChild(confirmationRing);
			}
		});
		// Sparkle particles for successful purchase
		for (var i = 0; i < 5; i++) {
			(function (index) {
				var sparkle = LK.getAsset('fire', {
					anchorX: 0.5,
					anchorY: 0.5,
					x: droneFactoryButton.x + (Math.random() - 0.5) * 100,
					y: droneFactoryButton.y + (Math.random() - 0.5) * 50,
					alpha: 0.9,
					tint: 0xAAFF88,
					scaleX: 0.2,
					scaleY: 0.2
				});
				LK.gui.topRight.addChild(sparkle);
				LK.setTimeout(function () {
					tween(sparkle, {
						alpha: 0,
						y: sparkle.y - 60,
						scaleX: 0.8,
						scaleY: 0.8
					}, {
						duration: 800,
						easing: tween.easeOut,
						onFinish: function onFinish() {
							LK.gui.topRight.removeChild(sparkle);
						}
					});
				}, index * 150);
			})(i);
		}
		isPlacingTower = true;
		selectedTowerIndex = 5; // Index of Drone Factory in availableTurrets
		// Create tower placement indicator with Drone Factory tint
		placingTowerIndicator = LK.getAsset('tower', {
			anchorX: 0.5,
			anchorY: 1.0,
			alpha: 0.5,
			tint: 0x55FF55 // Green tint for Drone Factory
		});
		game.addChild(placingTowerIndicator);
		// Deselect any selected tower
		if (selectedTower) {
			selectedTower.deselect();
			selectedTower = null;
		}
	} else {
		// Enhanced error feedback for insufficient funds
		var errorBurst = LK.getAsset('rangeIndicator', {
			anchorX: 0.5,
			anchorY: 0.5,
			x: droneFactoryButton.x,
			y: droneFactoryButton.y,
			alpha: 0.8,
			tint: 0xFF6666,
			width: 30,
			height: 30
		});
		LK.gui.topRight.addChild(errorBurst);
		tween(errorBurst, {
			alpha: 0,
			width: 150,
			height: 150
		}, {
			duration: 500,
			onFinish: function onFinish() {
				LK.gui.topRight.removeChild(errorBurst);
			}
		});
		// Multiple shake iterations for stronger feedback
		var originalX = droneFactoryButton.x;
		var shakeCount = 0;
		var maxShakes = 3;
		var _performShake = function performShake() {
			if (shakeCount < maxShakes) {
				tween(droneFactoryButton, {
					x: originalX + (shakeCount % 2 === 0 ? -8 : 8)
				}, {
					duration: 60,
					onFinish: function onFinish() {
						shakeCount++;
						_performShake();
					}
				});
			} else {
				tween(droneFactoryButton, {
					x: originalX
				}, {
					duration: 100,
					easing: tween.easeOut
				});
			}
		};
		_performShake();
	}
};
goldText.anchor.set(0, 0);
LK.gui.topRight.addChild(goldText);
goldText.x = -200;
goldText.y = 70;
var livesText = new Text2('Lives: ' + playerLives, {
	size: 36,
	fill: 0xFF0000
});
livesText.anchor.set(0, 0);
LK.gui.topRight.addChild(livesText);
livesText.x = -200;
livesText.y = 120;
var waveText = new Text2('Wave: 0', {
	size: 36,
	fill: 0xFFFFFF
});
waveText.anchor.set(0, 0);
LK.gui.topRight.addChild(waveText);
waveText.x = -200;
waveText.y = 170;
// Create a new tower purchase menu with improved layout
var towerMenu = new Container();
towerMenu.x = 100;
towerMenu.y = 2500;
game.addChild(towerMenu);
// Create buttons for all available turrets with improved spacing and visibility
turretShop.availableTurrets.forEach(function (turret, index) {
	var buttonColor = 0x4444cc;
	var imageAsset = 'basicTurretButton';
	if (turret.type === 'bomb') {
		buttonColor = 0xFF8800; // Orange for bomb tower
		imageAsset = 'bombTowerButton';
	} else if (turret.type === 'em') {
		buttonColor = 0x00AAFF; // Blue for EM tower
		imageAsset = 'emTowerButton';
	} else if (turret.type === 'drone') {
		buttonColor = 0x55FF55; // Green for Drone Factory
		imageAsset = 'droneFactoryButton';
	} else if (turret.type === 'defensegrid') {
		buttonColor = 0x00FF88; // Green-cyan for Defense Grid
		imageAsset = 'emTowerButton'; // Reuse EM tower button asset
	} else if (turret.name.includes('Sniper')) {
		imageAsset = 'sniperTurretButton';
	} else if (turret.name.includes('Cannon')) {
		imageAsset = 'cannonTurretButton';
	}
	var buttonText = turret.name + '\n' + turret.cost + 'g';
	var turretButton = new Button(buttonText, 500, 150, buttonColor, imageAsset);
	turretButton.x = 0;
	turretButton.y = index * 170; // Increase spacing for larger buttons
	// Add enhanced hover effect simulation through pulsing
	var pulseTimer = LK.setInterval(function () {
		if (gold >= turret.cost && !isPlacingTower) {
			tween(turretButton, {
				scaleX: 1.02,
				scaleY: 1.02
			}, {
				duration: 800,
				yoyo: true,
				easing: tween.easeInOut
			});
		}
	}, 2000 + Math.random() * 1000);
	turretButton.onClick = function () {
		if (gold >= turret.cost && !isPlacingTower) {
			// Enhanced button press with turret-specific animations
			if (turret.type === 'bomb') {
				// Explosive press animation
				tween(turretButton, {
					scaleX: 0.9,
					scaleY: 0.9
				}, {
					duration: 80,
					onFinish: function onFinish() {
						tween(turretButton, {
							scaleX: 1.1,
							scaleY: 1.1
						}, {
							duration: 120,
							onFinish: function onFinish() {
								tween(turretButton, {
									scaleX: 1.0,
									scaleY: 1.0
								}, {
									duration: 100,
									easing: tween.bounceOut
								});
							}
						});
					}
				});
			} else if (turret.type === 'em') {
				// Electric pulse animation
				var pulseRing = LK.getAsset('rangeIndicator', {
					anchorX: 0.5,
					anchorY: 0.5,
					x: turretButton.x + 200,
					y: turretButton.y + 40,
					alpha: 0.6,
					tint: 0x00AAFF,
					width: 20,
					height: 20
				});
				towerMenu.addChild(pulseRing);
				tween(pulseRing, {
					alpha: 0,
					width: 120,
					height: 120
				}, {
					duration: 500,
					onFinish: function onFinish() {
						towerMenu.removeChild(pulseRing);
					}
				});
			} else if (turret.type === 'drone') {
				// Drone swarm animation
				for (var d = 0; d < 3; d++) {
					(function (droneIndex) {
						var drone = LK.getAsset('fire', {
							anchorX: 0.5,
							anchorY: 0.5,
							x: turretButton.x + 200,
							y: turretButton.y + 40,
							alpha: 0.8,
							tint: 0x55FF55,
							scaleX: 0.2,
							scaleY: 0.2
						});
						towerMenu.addChild(drone);
						var angle = droneIndex * Math.PI * 2 / 3;
						var distance = 60;
						tween(drone, {
							x: turretButton.x + 200 + Math.cos(angle) * distance,
							y: turretButton.y + 40 + Math.sin(angle) * distance,
							alpha: 0,
							scaleX: 0.05,
							scaleY: 0.05
						}, {
							duration: 600,
							onFinish: function onFinish() {
								towerMenu.removeChild(drone);
							}
						});
					})(d);
				}
			} else {
				// Standard tower press animation
				tween(turretButton, {
					scaleX: 0.95,
					scaleY: 0.95
				}, {
					duration: 100,
					onFinish: function onFinish() {
						tween(turretButton, {
							scaleX: 1.0,
							scaleY: 1.0
						}, {
							duration: 150,
							easing: tween.elasticOut
						});
					}
				});
			}
			// Success confirmation effect
			var confirmationEffect = LK.getAsset('fire', {
				anchorX: 0.5,
				anchorY: 0.5,
				x: turretButton.x + 200,
				y: turretButton.y + 40,
				alpha: 0.9,
				tint: buttonColor,
				scaleX: 0.5,
				scaleY: 0.5
			});
			towerMenu.addChild(confirmationEffect);
			tween(confirmationEffect, {
				alpha: 0,
				scaleX: 2.0,
				scaleY: 2.0
			}, {
				duration: 600,
				onFinish: function onFinish() {
					towerMenu.removeChild(confirmationEffect);
				}
			});
			isPlacingTower = true;
			selectedTowerIndex = index;
			// Create tower placement indicator with appropriate tint
			placingTowerIndicator = LK.getAsset('tower', {
				anchorX: 0.5,
				anchorY: 1.0,
				alpha: 0.5,
				tint: buttonColor
			});
			game.addChild(placingTowerIndicator);
			// Deselect any selected tower
			if (selectedTower) {
				selectedTower.deselect();
				selectedTower = null;
			}
		} else {
			// Enhanced insufficient funds feedback with button-specific effects
			if (gold < turret.cost) {
				// Highlight gold text to show insufficient funds
				tween(goldText, {
					tint: 0xFF4444,
					scaleX: 1.1,
					scaleY: 1.1
				}, {
					duration: 200,
					onFinish: function onFinish() {
						tween(goldText, {
							tint: 0xFFFF00,
							scaleX: 1.0,
							scaleY: 1.0
						}, {
							duration: 300
						});
					}
				});
			}
			// Button error animation
			var errorShake = LK.getAsset('fire', {
				anchorX: 0.5,
				anchorY: 0.5,
				x: turretButton.x + 200,
				y: turretButton.y + 40,
				alpha: 0.6,
				tint: 0xFF6666,
				scaleX: 0.3,
				scaleY: 0.3
			});
			towerMenu.addChild(errorShake);
			tween(errorShake, {
				alpha: 0,
				y: turretButton.y + 10,
				scaleX: 1.0,
				scaleY: 1.0
			}, {
				duration: 700,
				onFinish: function onFinish() {
					towerMenu.removeChild(errorShake);
				}
			});
			// Button shake animation
			var originalX = turretButton.x;
			tween(turretButton, {
				x: originalX - 8
			}, {
				duration: 60,
				onFinish: function onFinish() {
					tween(turretButton, {
						x: originalX + 8
					}, {
						duration: 60,
						onFinish: function onFinish() {
							tween(turretButton, {
								x: originalX
							}, {
								duration: 60
							});
						}
					});
				}
			});
		}
	};
	towerMenu.addChild(turretButton);
});
