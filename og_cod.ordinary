			// Expanding transformation ring effect
			tween(transformationEffect, {
				alpha: 0,
				scaleX: 2.0,
				scaleY: 2.0
			}, {
				duration: 1500,
				easing: tween.easeOut
			});
			// Play thunder sound for dramatic effect
			LK.getSound('thunder').play();
			// Screen flash for transformation
			LK.effects.flashScreen(shouldFlyToBase ? 0xFF0000 : 0xFF4400, 500);
		}
		// Reset transformation timer regardless of whether transformation occurred
		self.cloudTransformationTimer = 0;
		self.nextTransformationTime = 30000 + Math.random() * 30000; // 30-60 seconds (longer intervals)
	};
	// Fade in the storm
	tween(self, {
		alpha: 1
	}, {
		duration: 3000
	});
	return self;
});
var Tower = Container.expand(function (gridX, gridY) {
	var self = Container.call(this);
	self.level = 1;
	self.damage = 40;
	self.range = 150;
	self.fireRate = 1000;
	self.lastFireTime = 0;
	self.gridX = gridX;
	self.gridY = gridY;
	self.cost = 50;
	self.targetEnemy = null;
	self.isSelected = false;
	var towerGraphic = self.attachAsset('towerImage', {
		anchorX: 0.5,
		anchorY: 1.0,
		scaleX: 2.4,
		scaleY: 2.4
	});
	var rangeIndicator = self.attachAsset('rangeIndicator', {
		anchorX: 0.5,
		anchorY: 0.5,
		alpha: 0
	});
	rangeIndicator.width = self.range * 2;
	rangeIndicator.height = self.range * 2;
	self.y -= 20;
	self.down = function (x, y, obj) {
		selectTower(self);
	};
	self.findTarget = function (enemies) {
		self.targetEnemy = null;
		var closestDistance = self.range;
		for (var i = 0; i < enemies.length; i++) {
			var enemy = enemies[i];
			if (enemy.isDead) {
				continue;
			}
			var dx = enemy.x - self.x;
			var dy = enemy.y - self.y;
			var distance = Math.sqrt(dx * dx + dy * dy);
			if (distance <= self.range && distance < closestDistance) {
				closestDistance = distance;
				self.targetEnemy = enemy;
			}
		}
		return self.targetEnemy !== null;
	};
	self.shoot = function () {
